<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Packing List {{ doc_id }}</title>
<style>
  body { font-family: Arial, sans-serif; font-size: 12px; color: #222; margin: 40px; }
  h1 { font-size: 22px; margin: 0; }
  .header { display: flex; justify-content: space-between; border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 20px; }
  .meta-block div { margin-bottom: 4px; }
  .meta-block strong { display: inline-block; width: 160px; }
  .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
  .party-box { border: 1px solid #ccc; padding: 12px; border-radius: 4px; }
  .party-box h3 { margin: 0 0 8px 0; font-size: 13px; color: #555; text-transform: uppercase; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  th { background: #333; color: #fff; padding: 8px; text-align: left; }
  td { padding: 8px; border-bottom: 1px solid #ddd; }
  .total-row td { font-weight: bold; background: #f5f5f5; }
  .footer { margin-top: 40px; border-top: 1px solid #333; padding-top: 8px; }
</style>
</head>
<body>

<div class="header">
  <div>
    <h1>PACKING LIST</h1>
    <p style="margin:4px 0; color:#555;">No. {{ doc_id }}</p>
  </div>
  <div style="text-align:right;">
    <strong>{{ exporter_name }}</strong><br>
    {{ exporter_address }}
  </div>
</div>

<div class="meta-block" style="margin-bottom:16px;">
  <div><strong>Date:</strong> {{ packing_date }}</div>
  <div><strong>Deal Reference:</strong> {{ deal_id }}</div>
  <div><strong>Port of Loading:</strong> {{ port_of_loading }}</div>
  <div><strong>Port of Destination:</strong> {{ port_of_destination }}</div>
</div>

<div class="parties">
  <div class="party-box">
    <h3>Exporter</h3>
    <strong>{{ exporter_name }}</strong><br>
    {{ exporter_address }}
  </div>
  <div class="party-box">
    <h3>Consignee</h3>
    <strong>{{ buyer_name }}</strong><br>
    {{ buyer_address }}
  </div>
</div>

<table>
  <thead>
    <tr>
      <th>HS Code</th>
      <th>Description</th>
      <th>No. of Packages</th>
      <th>Package Type</th>
      <th>Net Weight (MT)</th>
      <th>Gross Weight (MT)</th>
      <th>Marks &amp; Numbers</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>{{ hs_code }}</td>
      <td>{{ description }}</td>
      <td>{{ no_of_packages }}</td>
      <td>{{ package_type }}</td>
      <td>{{ "%.3f"|format(net_weight_mt) }}</td>
      <td>{{ "%.3f"|format(gross_weight_mt) }}</td>
      <td>{{ marks_and_numbers }}</td>
    </tr>
    <tr class="total-row">
      <td colspan="4">TOTAL</td>
      <td>{{ "%.3f"|format(net_weight_mt) }} MT</td>
      <td>{{ "%.3f"|format(gross_weight_mt) }} MT</td>
      <td></td>
    </tr>
  </tbody>
</table>

<div class="footer">
  <p>Authorised Signatory — <strong>{{ exporter_name }}</strong> &nbsp;&nbsp; Date: {{ packing_date }}</p>
</div>

</body>
</html>
