{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block kind %}Packing List{% endblock %}
{% block number %}{{ doc_id }}{% endblock %}
{% block facts %}
  {{ m.fact("Date", doc_date | date) }}
  {{ m.fact("Commercial invoice", invoice_ref, mono=True) }}
  {{ m.fact("Port of loading", port_of_loading) }}
  {{ m.fact("Port of discharge", port_of_destination) }}
{% endblock %}
{% block content %}
<h2>Parties</h2>
<div class="grid-2">
  {{ m.exporter_card(exporter, "Exporter / Shipper") }}
  {{ m.party("Consignee", buyer.legal_name, [buyer.address, buyer.country]) }}
</div>

<h2>Packing</h2>
<table>
  <thead><tr><th>Container</th><th>Seal</th><th>Marks</th><th>Description</th><th class="num">Packages</th><th class="num">Net (MT)</th><th class="num">Gross (MT)</th></tr></thead>
  <tbody>
  {% for row in rows %}
    <tr>
      <td class="mono">{{ row.container or "—" }}</td>
      <td class="mono">{{ row.seal or "—" }}</td>
      <td>{{ marks }}</td>
      <td><strong>{{ product }}</strong><div class="small muted">HS {{ hs_code }}{% if package_type %} · {{ package_type }}{% endif %}</div></td>
      <td class="num">{{ row.packages if row.packages else "—" }}</td>
      <td class="num">{{ row.net | qty }}</td>
      <td class="num">{{ row.gross | qty if row.gross else "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<div class="totals">
  <div class="row"><span>Total packages</span><span>{{ packages or "—" }}</span></div>
  <div class="row"><span>Total net weight</span><span>{{ net_weight_mt | qty }} MT</span></div>
  <div class="row grand"><span>Total gross weight</span><span>{{ (gross_weight_mt | qty ~ " MT") if gross_weight_mt else "—" }}</span></div>
</div>
{% if loading_source %}<p class="small muted" style="margin-top:10px">Weights and container / seal numbers as recorded by the inspector at stuffing ({{ loading_source }}).</p>{% endif %}

<div class="signs">
  {{ m.exporter_sign(exporter) }}
  <div></div>
</div>
{% endblock %}
