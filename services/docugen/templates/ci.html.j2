{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block kind %}Commercial Invoice{% endblock %}
{% block kind_sub %}<div class="kind-sub">Export invoice</div>{% endblock %}
{% block number %}{{ doc_id }}{% endblock %}
{% block facts %}
  {{ m.fact("Invoice date", doc_date | date) }}
  {{ m.fact("Proforma Invoice", pi_id, mono=True) }}
  {{ m.fact("Incoterms® 2020", incoterm ~ " " ~ (port_of_destination or "")) }}
  {{ m.fact("Country of origin", "India") }}
{% endblock %}
{% block content %}
<h2>Parties</h2>
<div class="grid-3">
  {{ m.exporter_card(exporter, "Exporter / Shipper") }}
  {{ m.party("Consignee / Buyer", buyer.legal_name, [buyer.address, buyer.country], {"VAT / Tax ID": buyer.vat_number}) }}
  {{ m.party("Notify party", notify_party or "Same as consignee", []) }}
</div>

<h2>Shipment</h2>
<div class="grid-2">
  {{ m.kv([("Port of loading", port_of_loading), ("Port of discharge", port_of_destination), ("Final destination", destination_country),
           ("Vessel / voyage", (vessel ~ (" / " ~ voyage if voyage else "")) if vessel else None)]) }}
  {{ m.kv([("Bill of lading", bl_number), ("Container(s)", containers | join(", ")), ("Seal(s)", seals | join(", ")),
           ("Pre-carriage", "Road")]) }}
</div>

<h2>Goods</h2>
<table>
  <thead><tr><th>#</th><th>Marks & description</th><th>HS code</th><th class="num">Quantity (MT)</th><th class="num">Unit price ({{ currency }}/MT)</th><th class="num">Amount ({{ currency }})</th></tr></thead>
  <tbody>
    <tr>
      <td>1</td>
      <td><strong>{{ product }}</strong>
        <div class="small muted">Marks: {{ marks }}{% if packages %} · {{ packages }} {{ package_type or "packages" }}{% endif %}</div>
        {% if quantity_note %}<div class="small muted">{{ quantity_note }}</div>{% endif %}</td>
      <td class="mono">{{ hs_code }}</td>
      <td class="num">{{ shipped_quantity_mt | qty }}</td>
      <td class="num">{{ unit_price | money(None, 2) }}</td>
      <td class="num">{{ total_value | money }}</td>
    </tr>
  </tbody>
</table>
{{ m.totals([], "Total " ~ incoterm ~ " " ~ (port_of_destination or ""), total_value, currency) }}

<h2>Payment</h2>
<p>{{ payment_terms }}</p>
{% if escrow_id %}<p class="small muted">Paid into neutral escrow — reference <span class="mono">{{ escrow_id }}</span>.</p>{% endif %}

<div class="notice accent">
  {% if exporter.lut_arn %}Supply meant for export under Letter of Undertaking (ARN <span class="mono">{{ exporter.lut_arn }}</span>) without payment of IGST.
  {% else %}Supply meant for export under Letter of Undertaking without payment of IGST.{% endif %}
</div>
<p class="small" style="margin-top:12px">We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.</p>

<div class="signs">
  {{ m.exporter_sign(exporter) }}
  <div></div>
</div>
{% endblock %}
