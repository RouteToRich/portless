<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Shipper's Declaration Form {{ doc_id }}</title>
<style>
  body { font-family: Arial, sans-serif; font-size: 12px; color: #222; margin: 40px; }
  h1 { font-size: 20px; margin: 0; }
  h2 { font-size: 13px; color: #555; margin: 4px 0 0; }
  .header { border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 20px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 12px; }
  .field { border: 1px solid #ccc; padding: 10px; border-radius: 4px; }
  .field label { font-size: 10px; color: #888; display: block; margin-bottom: 4px; text-transform: uppercase; }
  .declaration { background: #fff3e0; border-left: 4px solid #fb8c00; padding: 12px 16px; margin: 16px 0; font-size: 11px; }
  .footer { margin-top: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .sig-box { border-top: 1px solid #333; padding-top: 8px; }
</style>
</head>
<body>

<div class="header">
  <h1>SHIPPER'S DECLARATION FORM (SDF)</h1>
  <h2>Reserve Bank of India — Foreign Exchange Management Act</h2>
  <p style="margin:8px 0 0; color:#555;">No. {{ doc_id }} &nbsp;|&nbsp; Date: {{ sdf_date }}</p>
</div>

<div class="row">
  <div class="field">
    <label>Exporter / AD Code</label>
    <strong>{{ exporter_name }}</strong><br>
    {{ exporter_address }}<br>
    {% if exporter_iec %}IEC: {{ exporter_iec }}{% endif %}
  </div>
  <div class="field">
    <label>Consignee</label>
    <strong>{{ buyer_name }}</strong><br>
    {{ buyer_address }}
  </div>
</div>

<div class="row">
  <div class="field">
    <label>Port of Loading</label>
    {{ port_of_loading }}
  </div>
  <div class="field">
    <label>Port of Destination</label>
    {{ port_of_destination }}
  </div>
</div>

<div class="row">
  <div class="field">
    <label>HS Code</label>
    {{ hs_code }}
  </div>
  <div class="field">
    <label>Goods Description</label>
    {{ description }}
  </div>
</div>

<div class="row">
  <div class="field">
    <label>Quantity (MT)</label>
    {{ "%.3f"|format(quantity_mt) }}
  </div>
  <div class="field">
    <label>FOB Value ({{ currency }})</label>
    {{ "%.2f"|format(fob_value) }}
  </div>
</div>

<div class="row">
  <div class="field">
    <label>Payment Terms</label>
    {{ payment_terms }}
  </div>
  <div class="field">
    <label>Country of Destination</label>
    {{ country_of_destination }}
  </div>
</div>

{% if vessel_name or bill_of_lading_number %}
<div class="row">
  <div class="field">
    <label>Vessel / Flight No.</label>
    {{ vessel_name or "—" }}{% if voyage_number %} / {{ voyage_number }}{% endif %}
  </div>
  <div class="field">
    <label>Bill of Lading No.</label>
    {{ bill_of_lading_number or "—" }}
  </div>
</div>
{% endif %}

<div class="declaration">
  <strong>Declaration:</strong> I/We hereby declare that the particulars given above are true
  and correct and that the value stated is the full export value of the goods exported and
  I/We undertake to realise the full export proceeds within the prescribed period as per the
  provisions of the Foreign Exchange Management Act, 1999.
</div>

<div class="footer">
  <div class="sig-box">
    <p>Signature of Exporter<br><strong>{{ exporter_name }}</strong><br>Date: {{ sdf_date }}</p>
  </div>
  <div class="sig-box">
    <p>Customs Certification<br>Date: ___________</p>
  </div>
</div>

</body>
</html>
