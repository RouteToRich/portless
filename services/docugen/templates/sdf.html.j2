{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block kind %}Export Declaration (SDF){% endblock %}
{% block kind_sub %}<div class="kind-sub">Declaration under the Foreign Exchange Management Act, 1999</div>{% endblock %}
{% block number %}{{ doc_id }}{% endblock %}
{% block facts %}
  {{ m.fact("Date", doc_date | date) }}
  {{ m.fact("Exporter IEC", exporter.iec, mono=True) }}
  {{ m.fact("AD bank code", exporter.ad_code, mono=True) }}
  {{ m.fact("Commercial invoice", invoice_ref, mono=True) }}
{% endblock %}
{% block content %}
<h2>Export particulars</h2>
<div class="grid-2">
  {{ m.exporter_card(exporter, "Exporter") }}
  {{ m.party("Buyer", buyer.legal_name, [buyer.address, buyer.country]) }}
</div>
<table style="margin-top:12px">
  <thead><tr><th>Description</th><th>HS code</th><th class="num">Quantity (MT)</th><th class="num">Invoice value ({{ currency }}, {{ incoterm }})</th><th class="num">FOB value ({{ currency }})</th></tr></thead>
  <tbody>
    <tr>
      <td><strong>{{ product }}</strong></td>
      <td class="mono">{{ hs_code }}</td>
      <td class="num">{{ shipped_quantity_mt | qty }}</td>
      <td class="num">{{ total_value | money }}</td>
      <td class="num">{{ fob_value | money if fob_value else "—" }}</td>
    </tr>
  </tbody>
</table>
{% if fob_basis %}<p class="small muted" style="margin-top:6px">{{ fob_basis }}</p>{% endif %}

<h2>Declaration</h2>
<ol class="clauses">
  <li>I/We hereby declare that I/we am/are the <strong>seller</strong> of the goods in respect of which this declaration is made, and that the particulars given in the Shipping Bill are true.</li>
  <li>The value as contracted with the buyer is the full export value of the goods: {{ total_value | money(currency) }} ({{ incoterm }}).</li>
  <li>I/We undertake to realise and repatriate the full export value to India within the period prescribed by the Reserve Bank of India. Payment is held in a neutral escrow ({{ escrow_provider or "escrow" }}) and released in stages.</li>
  <li>I/We undertake to submit the export documents to the Authorised Dealer bank (code {{ exporter.ad_code or "____" }}) within the prescribed period.</li>
</ol>

<div class="signs">
  {{ m.exporter_sign(exporter) }}
  <div></div>
</div>
{% endblock %}
