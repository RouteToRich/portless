{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block kind %}Shipping Bill — Checklist{% endblock %}
{% block kind_sub %}<div class="kind-sub">Data for the customs broker's ICEGATE filing (free shipping bill)</div>{% endblock %}
{% block number %}{{ doc_id }}{% endblock %}
{% block chip %}{% if shipping_bill_number %}<div class="chip ok">Filed · SB {{ shipping_bill_number }}</div>{% else %}<div class="chip warn">To be filed</div>{% endif %}{% endblock %}
{% block facts %}
  {{ m.fact("Port of loading", port_of_loading) }}
  {{ m.fact("Country of destination", destination_country) }}
  {{ m.fact("Shipping Bill no.", shipping_bill_number, mono=True) }}
  {{ m.fact("Let Export Order", let_export_order, mono=True) }}
{% endblock %}
{% block content %}
<div class="notice">The legal Shipping Bill is generated by ICEGATE when the customs broker files it. This checklist carries every field they need, from the deal record.</div>

<h2>Exporter</h2>
<div class="grid-2">
  {{ m.exporter_card(exporter, "Exporter") }}
  {{ m.kv([("IEC", exporter.iec), ("GSTIN", exporter.gstin), ("AD code", exporter.ad_code),
           ("GST LUT ARN", exporter.lut_arn), ("Export under", "LUT — without payment of IGST")]) }}
</div>

<h2>Consignee and shipment</h2>
<div class="grid-2">
  {{ m.party("Consignee", buyer.legal_name, [buyer.address, buyer.country]) }}
  {{ m.kv([("Port of discharge", port_of_destination), ("Vessel / voyage", (vessel ~ (" / " ~ voyage if voyage else "")) if vessel else None),
           ("Container(s)", containers | join(", ")), ("Seal(s)", seals | join(", ")), ("Nature of cargo", "Containerised")]) }}
</div>

<h2>Invoice and item</h2>
<table>
  <thead><tr><th>Invoice</th><th>Description</th><th>ITC-HS</th><th class="num">Qty (MT)</th><th class="num">Invoice value ({{ currency }})</th><th class="num">FOB ({{ currency }})</th></tr></thead>
  <tbody>
    <tr>
      <td class="mono">{{ invoice_ref or "—" }}</td>
      <td><strong>{{ product }}</strong><div class="small muted">{{ incoterm }} · freight {{ freight_value | money(currency) if freight_value else "—" }} · insurance {{ insurance_value | money(currency) if insurance_value else "—" }}</div></td>
      <td class="mono">{{ hs_code }}</td>
      <td class="num">{{ shipped_quantity_mt | qty }}</td>
      <td class="num">{{ total_value | money }}</td>
      <td class="num">{{ fob_value | money if fob_value else "—" }}</td>
    </tr>
  </tbody>
</table>

<h2>Schemes and checks</h2>
<ul class="checks">
  <li>RoDTEP: {{ "claimed — declare on the shipping bill" if rodtep_declaration else "not claimed" }}</li>
  <li>Duty drawback: {{ "claimed" if draw_back_claim else "not claimed" }}</li>
  <li>Export policy for HS {{ hs_code }} confirmed against the ITC-HS export schedule ({{ hs_policy or "see compliance record" }})</li>
  <li>Container sealed under inspection{% if seals %}: seal {{ seals | join(", ") }}{% endif %}</li>
  <li>Attach: commercial invoice, packing list, export declaration (SDF), inspection certificate{% if needs_phyto %}, phytosanitary certificate{% endif %}</li>
</ul>

<div class="signs">
  {{ m.exporter_sign(exporter) }}
  {{ m.sign("Customs broker (CHA)", "", "Name, licence number, date") }}
</div>
{% endblock %}
