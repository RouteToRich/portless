{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block kind %}Certificate of Origin{% endblock %}
{% block kind_sub %}<div class="kind-sub">Non-preferential · Application for certification</div>{% endblock %}
{% block number %}{{ doc_id }}{% endblock %}
{% block chip %}<div class="chip warn">For certification by {{ chamber_name }}</div>{% endblock %}
{% block facts %}
  {{ m.fact("Date", doc_date | date) }}
  {{ m.fact("Country of origin", country_of_origin) }}
  {{ m.fact("Destination", destination_country) }}
  {{ m.fact("Commercial invoice", invoice_ref, mono=True) }}
{% endblock %}
{% block content %}
<div class="notice">This is the exporter's application. It becomes a Certificate of Origin only once certified by the issuing authority on the DGFT e-CoO platform; the certified certificate replaces this page in the shipping documents.</div>

<div class="grid-2" style="margin-top:12px">
  {{ m.exporter_card(exporter, "1. Exporter") }}
  {{ m.party("2. Consignee", buyer.legal_name, [buyer.address, buyer.country]) }}
</div>

<h2>3–5. Transport and goods</h2>
<div class="grid-2">
  {{ m.kv([("Means of transport", "Sea"), ("Port of loading", port_of_loading), ("Port of discharge", port_of_destination),
           ("Vessel / voyage", (vessel ~ (" / " ~ voyage if voyage else "")) if vessel else None)]) }}
  {{ m.kv([("Container(s)", containers | join(", ")), ("Bill of lading", bl_number)]) }}
</div>
<table style="margin-top:10px">
  <thead><tr><th>Marks & numbers</th><th>Number and kind of packages; description of goods</th><th>HS code</th><th>Origin criterion</th><th class="num">Quantity</th></tr></thead>
  <tbody>
    <tr>
      <td>{{ marks }}</td>
      <td><strong>{{ product }}</strong>{% if packages %}<div class="small muted">{{ packages }} {{ package_type or "packages" }}</div>{% endif %}</td>
      <td class="mono">{{ hs_code }}</td>
      <td>Wholly obtained / produced in {{ country_of_origin }}</td>
      <td class="num">{{ quantity_mt | qty }} MT</td>
    </tr>
  </tbody>
</table>

<h2>6. Declaration by the exporter</h2>
<p>The undersigned declares that the above details and statements are correct, that all the goods were produced in {{ country_of_origin }}, and that they comply with the origin requirements for goods exported to {{ destination_country or "the country of destination" }}.</p>

<div class="signs">
  {{ m.exporter_sign(exporter) }}
  {{ m.sign("7. Certification — " ~ chamber_name, "", "It is hereby certified that the declaration by the exporter is correct", "Stamp, signature and certificate number") }}
</div>
{% endblock %}
