{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block kind %}Purchase Order{% endblock %}
{% block number %}{{ po_id }}{% endblock %}
{% block chip %}<div class="chip">Escrow funded</div>{% endblock %}
{% block facts %}
  {{ m.fact("Order date", issued_at | date) }}
  {{ m.fact("Ready for loading by", delivery_deadline | date) }}
  {{ m.fact("Terms", incoterm ~ " " ~ (port_of_loading or "")) }}
  {{ m.fact("Deal reference", deal_id, mono=True) }}
{% endblock %}
{% block content %}
<h2>Parties</h2>
<div class="grid-2">
  {{ m.exporter_card(exporter, "Purchaser") }}
  {{ m.party("Supplier / Manufacturer", supplier_name, [supplier_address], {"GSTIN": supplier_gstin, "IEC": supplier_iec}) }}
</div>

<h2>Order</h2>
<table>
  <thead><tr><th>#</th><th>Description</th><th>HS code</th><th class="num">Quantity (MT)</th><th class="num">Price ({{ currency }}/MT {{ incoterm }})</th><th class="num">Amount ({{ currency }})</th></tr></thead>
  <tbody>
    <tr>
      <td>1</td>
      <td><strong>{{ product_description }}</strong>{% if quality_spec %}<div class="small muted">{{ quality_spec }}</div>{% endif %}</td>
      <td class="mono">{{ hs_code }}</td>
      <td class="num">{{ quantity_mt | qty }}</td>
      <td class="num">{{ agreed_price | money(None, 2) }}</td>
      <td class="num">{{ total_value | money }}</td>
    </tr>
  </tbody>
</table>
{{ m.totals([("Quantity tolerance", "± 5% at the order price")], "Order value", total_value, currency) }}

<h2>Payment</h2>
<p>{{ payment_terms }}</p>
<p class="small muted">The buyer's money for this order is already held in a neutral escrow account. Your payments are released from it as each milestone below is evidenced; the last share follows the buyer's acceptance of the goods.</p>
{{ m.timeline(tranches, total_value, currency) }}

<h2>Conditions</h2>
<ol class="clauses">
  <li><strong>Acknowledgement.</strong> Please acknowledge this order in writing. The inspection is booked once it is acknowledged.</li>
  <li><strong>Inspection and loading.</strong> An independent inspector checks quality, quantity and packing, supervises the stuffing and seals the container. The goods may not leave your premises before the inspection has passed.</li>
  <li><strong>Packing and marks.</strong> Export-worthy new packing, marked as instructed by the purchaser. No supplier name, price or invoice is to be placed in or on the packages.</li>
  <li><strong>Delivery.</strong> {{ incoterm }} {{ port_of_loading or "Indian seaport" }}, goods ready for loading by {{ delivery_deadline | date }}. Delay must be notified as soon as it is known.</li>
  <li><strong>Documents from the supplier.</strong> GST tax invoice to the purchaser (export supply), quality certificate / certificate of analysis, and any phytosanitary or fumigation certificate the goods require.</li>
  <li><strong>Confidentiality.</strong> The purchaser's customer and sale price are confidential. Direct contact with the purchaser's customer about this or future orders is not permitted.</li>
  <li><strong>Rejection.</strong> Goods failing the inspection are rejected; the supplier replaces them or the order is cancelled and released funds are returned.</li>
</ol>

<div class="signs">
  {{ m.exporter_sign(exporter, "For the Purchaser") }}
  {{ m.sign("Accepted for the Supplier — " ~ supplier_name, "", "Name, title, date and company seal") }}
</div>
{% endblock %}
