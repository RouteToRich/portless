{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block kind %}Proforma Invoice{% endblock %}
{% block number %}{{ pi_id }}{% endblock %}
{% block chip %}<div class="chip">Valid until {{ expires_at | date }}</div>{% endblock %}
{% block facts %}
  {{ m.fact("Issue date", issued_at | date) }}
  {{ m.fact("Valid until", expires_at | date) }}
  {{ m.fact("Incoterms® 2020", incoterm ~ " " ~ (port_of_destination or "")) }}
  {{ m.fact("Deal reference", deal_id, mono=True) }}
{% endblock %}
{% block content %}
<h2>Parties</h2>
<div class="grid-2">
  {{ m.exporter_card(exporter, "Seller / Exporter of record") }}
  {{ m.party("Buyer / Importer", buyer_name, [buyer_address, buyer_country], {"VAT / Tax ID": buyer_vat_number}) }}
</div>

<h2>Goods</h2>
<table>
  <thead><tr><th>#</th><th>Description of goods</th><th>HS code</th><th class="num">Quantity (MT)</th><th class="num">Unit price ({{ currency }}/MT)</th><th class="num">Amount ({{ currency }})</th></tr></thead>
  <tbody>
    <tr>
      <td>1</td>
      <td><strong>{{ product_description }}</strong><div class="small muted">Origin: India · Quality as agreed, verified by independent inspection before shipment</div>{% if packing %}<div class="small"><strong>Packing:</strong> {{ packing }}</div>{% endif %}</td>
      <td class="mono">{{ hs_code }}</td>
      <td class="num">{{ quantity_mt | qty }}</td>
      <td class="num">{{ agreed_price | money(None, 2) }}</td>
      <td class="num">{{ total_value | money }}</td>
    </tr>
  </tbody>
</table>
{{ m.totals([("Quantity tolerance", "± " ~ tolerance_pct ~ "% at the contract price")], "Total " ~ incoterm ~ " " ~ (port_of_destination or ""), total_value, currency) }}

<h2>Payment — neutral escrow, staged release</h2>
<p>{{ payment_terms }}</p>
{{ m.timeline(tranches, total_value, currency) }}
<p class="small muted">The buyer pays the full amount into an independent escrow account{% if escrow_provider %} held by {{ escrow_provider | title }}{% endif %}. Funds are released to the seller only as each milestone is evidenced; the final share is released on the buyer's acceptance of the delivered goods or when the acceptance window lapses.</p>

<h2>Shipment & inspection</h2>
<div class="grid-2">
  {{ m.kv([("Port of loading", port_of_loading or "Indian seaport, advised on booking"),
           ("Port of destination", port_of_destination or "To be confirmed by the buyer"),
           ("Country of origin", "India"),
           ("Partial shipment", "Not allowed"), ("Transhipment", "Allowed")]) }}
  {{ m.kv([("Inspection", (qc_provider | upper if qc_provider else "Independent inspection agency") ~ " — quality, quantity, packing, supervised loading and container sealing"),
           ("Insurance", "Marine cargo insurance for 110% of the invoice value" if incoterm in ("CIF", "CIP") else "Buyer's responsibility"),
           ("Documents", "Commercial invoice, packing list, bill of lading, certificate of origin, inspection certificate" ~ (", insurance certificate" if incoterm in ("CIF", "CIP") else ""))]) }}
</div>

<div class="notice warn">
  This Proforma Invoice is an offer valid for <strong>{{ validity_days }} days</strong>, until <strong>{{ expires_at | date }}</strong>.
  It becomes binding when the buyer accepts it in writing within that period; a Sales Contract then records the full terms.
</div>

<div class="signs">
  {{ m.exporter_sign(exporter) }}
  {{ m.sign("Accepted for the Buyer — " ~ buyer_name, "", "Name, title, date and company seal") }}
</div>
{% endblock %}
