  Rule: tests/test_repositories_contract.py — TestExceptions
    Every service repository: in-memory and Mongo backends obey the same contract.

    @unit @repositories_contract @async
    Scenario: Save get
      # tests/test_repositories_contract.py::TestExceptions::test_save_get
      Given the repo fixture
      When await repo.save(self._record())
      Then (await repo.get('E1')).deal_id == 'D1'
      And await repo.get('x') is None

    @unit @repositories_contract @async
    Scenario: By deal
      # tests/test_repositories_contract.py::TestExceptions::test_by_deal
      Given the repo fixture
      And await repo.save(self._record())
      When await repo.save(self._record(exception_id='E2', deal_id='D2'))
      Then [e.exception_id for e in await repo.list_by_deal('D1')] == ['E1']

    @unit @repositories_contract @async
    Scenario: By status
      # tests/test_repositories_contract.py::TestExceptions::test_by_status
      Given the repo fixture
      And await repo.save(self._record(status=ExceptionStatus.OPEN))
      When await repo.save(self._record(exception_id='E2', status=ExceptionStatus.RESOLVED))
      Then [e.exception_id for e in await repo.list_by_status(ExceptionStatus.RESOLVED)] == ['E2']

    @unit @repositories_contract @async
    Scenario: List all newest first with limit
      # tests/test_repositories_contract.py::TestExceptions::test_list_all_newest_first_with_limit
      Given the repo fixture
      And await repo.save(self._record(exception_id='old', raised_at=EARLIER))
      When await repo.save(self._record(exception_id='new', raised_at=NOW))
      Then [e.exception_id for e in await repo.list_all()] == ['new', 'old']
      And [e.exception_id for e in await repo.list_all(limit=1)] == ['new']

