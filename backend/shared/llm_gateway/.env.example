# =============================================================================
# LLM Gateway — Configuration Template
# Env-var prefix: LLM_
#
# USAGE:
#   cp .env.example .env
#   Fill in real values in .env  (never commit .env)
#
# PRODUCTION (keyvault migration path):
#   Each variable below becomes one keyvault secret, e.g.:
#     Azure KV:  az keyvault secret set --name LLM-GROQ-API-KEY --value "..."
#     AWS SM:    aws secretsmanager create-secret --name LLM_GROQ_API_KEY
# =============================================================================


# ── Auth (JWT) ────────────────────────────────────────────────────────────────
LLM_AUTH_ENABLED=false
LLM_JWT_SECRET=CHANGE_ME_IN_PRODUCTION
LLM_JWT_ALGORITHM=HS256
LLM_JWT_ISSUER=portless
LLM_JWT_AUDIENCE=portless-llm-gateway


# ── Primary model (optional — leave blank to start at Groq fallbacks) ────────
# OpenAI:    LLM_PRIMARY_CONNECTOR=openai   LLM_PRIMARY_MODEL=gpt-4o
# Anthropic: LLM_PRIMARY_CONNECTOR=anthropic LLM_PRIMARY_MODEL=claude-sonnet-4-6
# Self-hosted (OpenAI-compat): LLM_PRIMARY_CONNECTOR=http LLM_PRIMARY_BASE_URL=http://...
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=YOUR_OPENAI_OR_ANTHROPIC_KEY
LLM_PRIMARY_CONNECTOR=http
LLM_PRIMARY_BASE_URL=


# ── Groq fallback chain ───────────────────────────────────────────────────────
LLM_GROQ_API_KEY=YOUR_GROQ_API_KEY

# qwen/qwen3-32b was deprecated by Groq on 2026-07-17 — do not use it.
LLM_FALLBACK_1_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_1_CONNECTOR=groq
LLM_FALLBACK_1_API_KEY=

LLM_FALLBACK_2_MODEL=qwen/qwen3.6-27b
LLM_FALLBACK_2_CONNECTOR=groq
LLM_FALLBACK_2_API_KEY=

# openai/gpt-oss-safeguard-20b is a content-moderation classifier, not a chat
# model — use its general-purpose sibling gpt-oss-20b for drafting text.
LLM_FALLBACK_3_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_3_CONNECTOR=groq
LLM_FALLBACK_3_API_KEY=


# ── Embeddings ────────────────────────────────────────────────────────────────
# Single source of truth for the whole app's embedding model. Leave the key
# empty (or provider=local) to use offline LocalHashEmbeddings instead.
#
# Examples:
#   OpenAI: LLM_EMBEDDING_PROVIDER=openai LLM_EMBEDDING_MODEL=text-embedding-3-small
#   Gemini: LLM_EMBEDDING_PROVIDER=gemini LLM_EMBEDDING_MODEL=gemini-embedding-001
#     (google-genai SDK directly; dimensions is sent as output_dimensionality —
#      MRL truncation, so the returned vector always matches exactly)
LLM_EMBEDDING_PROVIDER=openai
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_API_KEY=YOUR_OPENAI_API_KEY
# Must match the model above and the Atlas $vectorSearch index's numDimensions.
#   openai text-embedding-3-small=1536, -3-large=3072
#   gemini-embedding-001 supports 768 / 1536 / 3072 (MRL truncation)
LLM_EMBEDDING_DIMENSIONS=1536


# ── Request / retry ───────────────────────────────────────────────────────────
LLM_REQUEST_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES_PER_MODEL=2
LLM_RETRY_BASE_DELAY_SECONDS=1.0


# ── Generation defaults ───────────────────────────────────────────────────────
LLM_LLM_TEMPERATURE=0.7
LLM_LLM_MAX_TOKENS=2048


# ── Request tracking ──────────────────────────────────────────────────────────
LLM_TRACKING_ENABLED=true
LLM_TRACKING_FILE_PATH=data/llm_gateway_tracking.txt


# ── MongoDB tracker ───────────────────────────────────────────────────────────
LLM_MONGO_TRACKER_ENABLED=true
LLM_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
LLM_MONGO_DB_NAME=gateway
LLM_MONGO_COLLECTION=llm_requests
LLM_MONGO_MAX_POOL_SIZE=50
LLM_MONGO_CONNECT_TIMEOUT_MS=5000
LLM_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
LLM_MONGO_SOCKET_TIMEOUT_MS=30000


# ── placeholder: Rate limiting ────────────────────────────────────────────────
LLM_RATE_LIMIT_ENABLED=false
LLM_RATE_LIMIT_RPM=60
LLM_RATE_LIMIT_TPM=100000
LLM_RATE_LIMIT_BACKEND=memory


# ── placeholder: Circuit breaker ─────────────────────────────────────────────
LLM_CIRCUIT_BREAKER_ENABLED=false
LLM_CB_FAILURE_THRESHOLD=5
LLM_CB_COOL_DOWN_SECONDS=60.0


# ── placeholder: Cost estimator ───────────────────────────────────────────────
LLM_COST_TRACKING_ENABLED=false
LLM_BUDGET_PER_CALLER_USD=0.0


# ── Response cache (shared MongoDB TTL cache) ─────────────────────────────────
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=120


# ── placeholder: Streaming ────────────────────────────────────────────────────
LLM_STREAM_FIRST_CHUNK_TIMEOUT_SECONDS=10.0


# ── placeholder: Health check ─────────────────────────────────────────────────
LLM_HEALTH_CHECK_ENABLED=false
LLM_HEALTH_CHECK_INTERVAL_SECONDS=30.0
LLM_HEALTH_CHECK_TIMEOUT_SECONDS=5.0


# ── placeholder: Prompt guard ─────────────────────────────────────────────────
LLM_PROMPT_GUARD_ENABLED=false
LLM_PROMPT_GUARD_MAX_INPUT_CHARS=32000
LLM_PROMPT_GUARD_MODE=heuristic
