# Optional. If omitted, the project uses local hash embeddings and a local extractive answer generator.
OPENAI_API_KEY=

# Set to true to use OpenAI embeddings and chat generation.
USE_OPENAI_EMBEDDINGS=false
USE_OPENAI_LLM=false

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Local Chroma persistence directory.
CHROMA_DIR=.chroma
COLLECTION_NAME=practice_rag

# Parent-child retrieval groups this many child chunks into one parent context.
CHILD_CHUNKS_PER_PARENT=3

# Optional local cross-encoder reranking. This may download the configured model.
USE_CROSS_ENCODER_RERANKER=false
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# External parent document storage keeps large parent context outside Chroma metadata.
PARENT_STORE_DIR=.parent_store

# Local graph database store for graph-hybrid retrieval.
GRAPH_STORE_DIR=.graph_store
GRAPH_RETRIEVAL_TOP_K=8

# Optional PDF layout and OCR support. OCR also requires local poppler/tesseract setup.
ENABLE_PDF_LAYOUT_EXTRACTION=true
ENABLE_PDF_OCR=false

# Optional stronger prompt-injection classification with an LLM.
USE_LLM_PROMPT_INJECTION_CLASSIFIER=false

# Advanced evaluation provider: local, ragas, deepeval, or llm.
ADVANCED_EVAL_PROVIDER=local
