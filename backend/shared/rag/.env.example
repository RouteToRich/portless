# =============================================================================
# RAG Module — Configuration Template
# Env-var prefix: RAG_
#
# USAGE:
#   cp .env.example .env
#   Fill in real values in .env  (never commit .env)
#
# PRODUCTION (keyvault migration path):
#   Each variable below becomes one keyvault secret, e.g.:
#     Azure KV:  az keyvault secret set --name RAG-MONGO-URI --value "..."
#     AWS SM:    aws secretsmanager create-secret --name RAG_MONGO_URI
# =============================================================================


# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Falls back to the app-wide MONGO_URI / MONGO_DB_NAME (see backend/.env.example)
# when these are left unset — RAG writes to the same single shared database as
# every other module, in its own collections.
# RAG_MONGO_URI=            # optional override of MONGO_URI
# RAG_MONGO_DB_NAME=        # optional override of MONGO_DB_NAME (default: portless)
RAG_CHUNKS_COLLECTION=chunks
RAG_PARENTS_COLLECTION=parent_docs
RAG_INGESTION_JOBS_COLLECTION=ingestion_jobs
RAG_MONGO_MAX_POOL_SIZE=50
RAG_MONGO_CONNECT_TIMEOUT_MS=5000
RAG_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000


# ── Atlas Vector Search index ─────────────────────────────────────────────────
# Create once in Atlas UI or via ensure_indexes() on startup.
# Index spec: type=vectorSearch, path=embedding,
#             numDimensions=<LLM_EMBEDDING_DIMENSIONS>, similarity=RAG_VECTOR_SIMILARITY
# numDimensions is set in shared/llm_gateway/.env.example, not here.
RAG_VECTOR_INDEX_NAME=vector_index
RAG_VECTOR_SIMILARITY=cosine

# Embedding model/provider/key are configured in shared/llm_gateway/.env.example
# (LLM_EMBEDDING_PROVIDER / LLM_EMBEDDING_MODEL / LLM_EMBEDDING_API_KEY /
# LLM_EMBEDDING_DIMENSIONS) — RAG has no embedding-model config of its own.


# ── Chunking ──────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_SEMANTIC_BREAKPOINT_PERCENTILE=25
RAG_CHILD_CHUNKS_PER_PARENT=3


# ── Retrieval ─────────────────────────────────────────────────────────────────
RAG_RETRIEVAL_TOP_K=8
RAG_RETRIEVAL_NUM_CANDIDATES=100
RAG_KEYWORD_SEARCH_FETCH_LIMIT=500


# ── Reranking ─────────────────────────────────────────────────────────────────
RAG_USE_CROSS_ENCODER_RERANKER=false
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# ── Generation ────────────────────────────────────────────────────────────────
RAG_RAG_TEMPERATURE=0.0
RAG_RAG_MAX_TOKENS=2048


# ── Document loading ──────────────────────────────────────────────────────────
RAG_ENABLE_PDF_LAYOUT_EXTRACTION=true
RAG_ENABLE_PDF_OCR=false


# ── Security ──────────────────────────────────────────────────────────────────
RAG_USE_LLM_PROMPT_INJECTION_CLASSIFIER=false


# ── Evaluation ────────────────────────────────────────────────────────────────
# Options: local (default), ragas, deepeval, llm
RAG_ADVANCED_EVAL_PROVIDER=local


# ── Graph DB / Hybrid RAG ──────────────────────────────────────────────────────
# See backend/shared/rag/src/graph_store.py for full design notes.
# Backends: mongo (recommended — shared MongoDB, no new service/creds),
# neo4j (needs URI/USER/PASSWORD), arangodb/falkordb (reserved, no-op).
RAG_GRAPH_RETRIEVAL_ENABLED=false
RAG_GRAPH_RETRIEVAL_TOP_K=8
RAG_GRAPH_DB_BACKEND=mongo
RAG_GRAPH_CHUNKS_COLLECTION=graph_chunks
# neo4j backend only:
RAG_GRAPH_DB_URI=
RAG_GRAPH_DB_USER=
RAG_GRAPH_DB_PASSWORD=
RAG_GRAPH_DB_DATABASE=


# ── Free web search (hybrid RAG, 4th leg) ──────────────────────────────────────
# Adds a web-search retrieval leg (Tavily free tier) alongside vector + keyword +
# graph search. Results pass through the same rerank/knee-point/prompt-injection
# safety filter as internal chunks before reaching the LLM. Provider credential
# (TAVILY_API_KEY) is set in backend/.env.example, not here.
RAG_WEB_SEARCH_ENABLED=false
RAG_WEB_SEARCH_TOP_K=3
