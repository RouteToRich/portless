<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Proforma Invoice {{ pi_id }}</title>
<style>
  body { font-family: Arial, sans-serif; font-size: 12px; color: #222; margin: 40px; }
  h1 { font-size: 22px; margin: 0; }
  .header { display: flex; justify-content: space-between; border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 20px; }
  .meta-block { margin-bottom: 16px; }
  .meta-block strong { display: inline-block; width: 160px; }
  .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
  .party-box { border: 1px solid #ccc; padding: 12px; border-radius: 4px; }
  .party-box h3 { margin: 0 0 8px 0; font-size: 13px; color: #555; text-transform: uppercase; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  th { background: #333; color: #fff; padding: 8px; text-align: left; }
  td { padding: 8px; border-bottom: 1px solid #ddd; }
  .total-row td { font-weight: bold; background: #f5f5f5; }
  .terms { background: #fafafa; border: 1px solid #e0e0e0; padding: 12px; border-radius: 4px; margin-bottom: 20px; }
  .footer { margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .sig-box { border-top: 1px solid #333; padding-top: 8px; }
  .validity-notice { background: #fff8e1; border-left: 4px solid #f9a825; padding: 10px 14px; margin-bottom: 20px; font-size: 11px; }
</style>
</head>
<body>

<div class="header">
  <div>
    <h1>PROFORMA INVOICE</h1>
    <p style="margin:4px 0; color:#555;">No. {{ pi_id }}</p>
  </div>
  <div style="text-align:right;">
    <strong>{{ seller_name }}</strong><br>
    {{ seller_address }}<br>
    {% if seller_iec %}IEC: {{ seller_iec }}<br>{% endif %}
    {% if seller_gstin %}GSTIN: {{ seller_gstin }}<br>{% endif %}
  </div>
</div>

<div class="meta-block">
  <div><strong>Issue Date:</strong> {{ issued_at }}</div>
  <div><strong>Valid Until:</strong> {{ expires_at }}</div>
  <div><strong>Deal Reference:</strong> {{ deal_id }}</div>
  <div><strong>Incoterm:</strong> {{ incoterm }} — {{ port_of_destination }}</div>
</div>

<div class="parties">
  <div class="party-box">
    <h3>Seller (Exporter)</h3>
    <strong>{{ seller_name }}</strong><br>
    {{ seller_address }}<br>
    {% if seller_gstin %}GSTIN: {{ seller_gstin }}<br>{% endif %}
    {% if seller_iec %}IEC: {{ seller_iec }}<br>{% endif %}
  </div>
  <div class="party-box">
    <h3>Buyer (Importer)</h3>
    <strong>{{ buyer_name }}</strong><br>
    {{ buyer_address }}<br>
    {% if buyer_vat_number %}VAT: {{ buyer_vat_number }}<br>{% endif %}
  </div>
</div>

<table>
  <thead>
    <tr>
      <th>HS Code</th>
      <th>Product Description</th>
      <th>Quantity (MT)</th>
      <th>Unit Price ({{ currency }})</th>
      <th>Amount ({{ currency }})</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>{{ hs_code }}</td>
      <td>{{ product_description }}</td>
      <td>{{ "%.3f"|format(quantity_mt) }}</td>
      <td>{{ "%.4f"|format(agreed_price) }}</td>
      <td>{{ "%.2f"|format(total_value) }}</td>
    </tr>
    <tr class="total-row">
      <td colspan="4" style="text-align:right;">TOTAL {{ incoterm }} {{ port_of_destination }}</td>
      <td>{{ currency }} {{ "%.2f"|format(total_value) }}</td>
    </tr>
  </tbody>
</table>

<div class="terms">
  <strong>Payment Terms:</strong> {{ payment_terms }}<br>
  <strong>Port of Loading:</strong> {{ port_of_loading }}<br>
  <strong>Port of Destination:</strong> {{ port_of_destination }}<br>
  <strong>Incoterm:</strong> {{ incoterm }}<br>
  <strong>Country of Origin:</strong> India
</div>

<div class="validity-notice">
  This Proforma Invoice is valid for <strong>{{ validity_days }} days</strong> from the date of issue
  (until <strong>{{ expires_at }}</strong>). Please confirm acceptance in writing within the validity
  period. This document does not constitute a binding contract until countersigned by both parties.
</div>

<div class="footer">
  <div class="sig-box">
    <p>Authorised Signatory — Seller<br><strong>{{ seller_name }}</strong></p>
  </div>
  <div class="sig-box">
    <p>Accepted by — Buyer<br><strong>{{ buyer_name }}</strong><br>Date: ___________</p>
  </div>
</div>

</body>
</html>
