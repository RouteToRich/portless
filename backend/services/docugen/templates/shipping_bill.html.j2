<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Shipping Bill {{ doc_id }}</title>
<style>
  body { font-family: Arial, sans-serif; font-size: 12px; color: #222; margin: 40px; }
  h1 { font-size: 20px; margin: 0; }
  h2 { font-size: 13px; color: #555; margin: 4px 0 0; }
  .header { border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 20px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 12px; }
  .row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 12px; }
  .field { border: 1px solid #ccc; padding: 10px; border-radius: 4px; }
  .field label { font-size: 10px; color: #888; display: block; margin-bottom: 4px; text-transform: uppercase; }
  table { width: 100%; border-collapse: collapse; margin: 16px 0; }
  th { background: #333; color: #fff; padding: 8px; text-align: left; }
  td { padding: 8px; border-bottom: 1px solid #ddd; }
  .total-row td { font-weight: bold; background: #f5f5f5; }
  .rodtep-box { background: #e8f5e9; border-left: 4px solid #43a047; padding: 10px 14px; margin: 12px 0; }
  .footer { margin-top: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .sig-box { border-top: 1px solid #333; padding-top: 8px; }
</style>
</head>
<body>

<div class="header">
  <h1>SHIPPING BILL FOR EXPORT OF GOODS</h1>
  <h2>ICEGATE — Indian Customs EDI System</h2>
  <p style="margin:8px 0 0; color:#555;">No. {{ doc_id }} &nbsp;|&nbsp; Date: {{ sb_date }}</p>
</div>

<div class="row">
  <div class="field">
    <label>Exporter IEC</label>
    {{ exporter_iec or "—" }}
  </div>
  <div class="field">
    <label>Exporter Name &amp; Address</label>
    <strong>{{ exporter_name }}</strong><br>{{ exporter_address }}
  </div>
</div>

<div class="row">
  <div class="field">
    <label>Consignee</label>
    <strong>{{ buyer_name }}</strong><br>{{ buyer_address }}
  </div>
  <div class="field">
    <label>Country of Destination</label>
    {{ country_of_destination }}
  </div>
</div>

<div class="row">
  <div class="field">
    <label>Port of Loading</label>
    {{ port_of_loading }}
  </div>
  <div class="field">
    <label>Port of Discharge</label>
    {{ port_of_destination }}
  </div>
</div>

<div class="row">
  <div class="field">
    <label>Vessel / Voyage No.</label>
    {{ vessel_name or "—" }}{% if voyage_number %} / {{ voyage_number }}{% endif %}
  </div>
  <div class="field">
    <label>Bill of Lading No.</label>
    {{ bill_of_lading_number or "—" }}
  </div>
</div>

<table>
  <thead>
    <tr>
      <th>Sr.</th>
      <th>HS Code</th>
      <th>Description of Goods</th>
      <th>Qty (MT)</th>
      <th>Unit</th>
      <th>FOB Rate ({{ currency }})</th>
      <th>FOB Value ({{ currency }})</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>1</td>
      <td>{{ hs_code }}</td>
      <td>{{ description }}</td>
      <td>{{ "%.3f"|format(quantity_mt) }}</td>
      <td>MT</td>
      <td>{{ "%.4f"|format(unit_price) }}</td>
      <td>{{ "%.2f"|format(fob_value) }}</td>
    </tr>
    <tr class="total-row">
      <td colspan="6" style="text-align:right;">TOTAL FOB VALUE</td>
      <td>{{ currency }} {{ "%.2f"|format(fob_value) }}</td>
    </tr>
  </tbody>
</table>

{% if rodtep_declaration %}
<div class="rodtep-box">
  <strong>RoDTEP Declaration:</strong> I/We hereby declare and undertake that the goods
  exported under this Shipping Bill are eligible for RoDTEP scheme benefits and the
  claim is made in accordance with the notified rates and conditions.
</div>
{% endif %}

{% if draw_back_claim %}
<div style="background:#fff8e1; border-left:4px solid #f9a825; padding:10px 14px; margin:12px 0;">
  <strong>Drawback Claim:</strong> Duty drawback is being claimed under Schedule-1
  of the Customs and Central Excise Duties Drawback Rules, 2017.
</div>
{% endif %}

<div class="footer">
  <div class="sig-box">
    <p>Signature of Exporter / CHA<br><strong>{{ exporter_name }}</strong><br>Date: {{ sb_date }}</p>
  </div>
  <div class="sig-box">
    <p>Let Export Order (LEO)<br>No: {{ let_export_order or "Pending" }}<br>Date: ___________</p>
  </div>
</div>

</body>
</html>
