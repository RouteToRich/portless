# PortLess service registry — base URLs used by inter-service REST clients.
#
# DEVELOPMENT (combined monolith on port 8081):
#   Run:  cd backend && uvicorn app:app --reload --port 8081
#   All modules are reachable at http://localhost:8081/<module-prefix>/...
#   The UI dev proxy rewrites /api -> http://localhost:8081
#
# PRODUCTION (each service on its own port — see docker-compose.yml):
#   Uncomment and set the individual service URLs below.

# --- Combined dev server (used by UI proxy) ---
COMBINED_URL=http://localhost:8081

# --- Individual service URLs (microservice / production mode) ---
API_GATEWAY_URL=http://localhost:8000
DEALS_URL=http://localhost:8001
TRADE_MIN_URL=http://localhost:8002
MATCH_ENGINE_URL=http://localhost:8003
SOURCING_URL=http://localhost:8004
NEGOTIATION_AGENT_URL=http://localhost:8005
DEALMAKER_URL=http://localhost:8006
SHIELD_LINK_URL=http://localhost:8007
DOCUGEN_URL=http://localhost:8008
ESCROW_GUARD_URL=http://localhost:8009
HITL_APPROVAL_URL=http://localhost:8010
EXCEPTION_RESOLVER_URL=http://localhost:8011

# Cross-cutting
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Trade-intelligence connector credentials
# ---------------------------------------------------------------------------
# UN Comtrade – Global trade volumes, HS code flow data, YoY demand growth
#   Registration : FREE tier available (500 calls/day, 100K records/call)
#     1. Create account : https://comtradeplus.un.org
#     2. Developer portal: https://comtradedeveloper.un.org
#     3. Products → Free APIs → Subscribe (auto-approved)
#     4. Key at: /profile → Show keys
#   Premium      : auto-issued on developer portal login; email comtrade@un.org
#   Docs         : https://uncomtrade.org/docs/un-comtrade-api/
COMTRADE_SUBSCRIPTION_KEY=your_comtrade_subscription_key_here

# --- FREE replacements (active in the default pipeline) ----------------------
# World Bank WITS (TRAINS) – applied import tariffs at HS-6 (Phase 3 tariff gate).
#   Replaces the paid ITC MacMap. NO KEY / NO REGISTRATION required — fully open.
#   Docs : https://wits.worldbank.org/witsapiintro.aspx
# (no env var needed)

# US Census International Trade – free US import statistics (Phase 1, US market).
#   HOW TO GET KEY (free, instant):
#     1. Request a key at https://api.census.gov/data/key_signup.html
#     2. Click the activation link in the confirmation email
#     3. Paste the key below
#   Docs : https://www.census.gov/data/developers/data-sets/international-trade.html
CENSUS_API_KEY=your_census_api_key_here

# EU Access2Markets – EU tariffs + NTBs + rules of origin (Phase 3, EU markets).
#   Preferred over WITS for EU destinations (richer NTB / rules-of-origin data).
#   The official portal API is not openly documented, so the production endpoint
#   is supplied here once confirmed (early-access / portal inspection). When left
#   empty, EU tariffs transparently fall back to the free WITS connector.
#   URL template — use {reporter} {partner} {product} placeholders, e.g.
#     https://trade.ec.europa.eu/access-to-markets/api/.../{partner}/{reporter}/{product}
#   Docs : https://trade.ec.europa.eu/access-to-markets
ACCESS2MARKETS_API_URL=
ACCESS2MARKETS_API_KEY=

# Alibaba International B2B – active buyer RFQ / live buying-intent feed
#   Registration : https://developer.alibaba.com → Create App
#                  → Apply for "International Trade" API product
#   Docs         : https://developer.alibaba.com
ALIBABA_APP_KEY=your_alibaba_app_key_here
ALIBABA_APP_SECRET=your_alibaba_app_secret_here

# --- LEGACY / PAID (retired from the default pipeline; optional) -------------
# These are no longer called by default — the free sources above replace them.
# Set a key only to re-enable the connector (see workflow-implementation.md →
# "Replaced / Legacy Trade-Min connectors").
#
# Volza (PAID $0.10/search + $0.02/record) – named buyers from BoL manifests
#   Registration : app.volza.com → API Settings → Generate Key
VOLZA_API_KEY=your_volza_api_key_here
# ITC Market Access Map (PAID subscription) – superseded by WITS
#   Registration : https://macmap.org/tools/macmap-api
MACMAP_API_KEY=your_macmap_api_key_here
# Trademo Intel (PAID) – supply-chain records, buyer risk profiling
TRADEMO_API_KEY=your_trademo_api_key_here
# ImportGenius / Panjiva (PAID, enterprise) – US/LatAm marine manifests
IMPORTGENIUS_API_KEY=your_importgenius_api_key_here

# IndiaMART – India's largest wholesale B2B directory (seller discovery)
#   Registration : seller.indiamart.com → API Settings → Generate Key
#   Docs         : https://seller.indiamart.com/lmsrest/
INDIAMART_API_KEY=your_indiamart_api_key_here
INDIAMART_MOBILE=your_registered_mobile_number_here

# TradeIndia – fallback wholesale directory for supplier profiles
#   Registration : tradeindia.com → API access → Generate Bearer token
TRADEINDIA_API_KEY=your_tradeindia_api_key_here

# EU TED (Tenders Electronic Daily) – EU institutional procurement notices
#   Registration : None required — fully open API
#   Docs         : https://ted.europa.eu/api/v3.0/
# (no key needed — add to env only if a proxy/token is required in future)

# GDELT Project – supply-chain disruption news monitor
#   Registration : None required — fully open API
#   Docs         : https://api.gdeltproject.org/api/v2/doc/doc
# (no key needed)

# ---------------------------------------------------------------------------
# RAG — Free web search retrieval leg (Tavily)
# ---------------------------------------------------------------------------
# Adds a web-search leg alongside vector + keyword + graph retrieval in the
# RAG query pipeline (backend/shared/rag/src/web_search.py). Enable with
# RAG_WEB_SEARCH_ENABLED=true in backend/shared/rag/.env.example — leave the
# key blank to keep the pipeline internal-only (the leg silently contributes
# no results rather than fabricating any).
#   Registration : https://app.tavily.com → Sign up → API Keys (free tier,
#                  1,000 searches/month, no credit card required)
#   Docs         : https://docs.tavily.com/documentation/api-reference/endpoint/search
TAVILY_API_KEY=your_tavily_api_key_here

# Also consumed by the Negotiation Agent's live market-context leg (buyer/supplier
# pricing & demand color pulled fresh before each drafted email) — governed by
# NEGOTIATION_MARKET_SEARCH_ENABLED in backend/agents/negotiation_agent/config.py.
# Off by default; same fail-open behavior as RAG_WEB_SEARCH_ENABLED above (no key
# → no network call, no fabricated result). Retrieved snippets are screened by the
# same prompt-injection filter as RAG chunks before reaching any drafting prompt,
# and every drafted email is still routed through the existing L0 HITL approval
# gate regardless (defense-in-depth, not a replacement for the filter).
# NEGOTIATION_MARKET_SEARCH_ENABLED=true

# ===========================================================================
# MongoDB — ONE connection string + ONE database for the whole application
# ===========================================================================
# Set MONGO_URI and MONGO_DB_NAME once — EVERY service/module persists into that
# single database, each via its own collection(s) (deals, opportunities, rfqs,
# quotes, chunks, llm_requests, …), so nothing collides. This is a genuinely
# single-database deployment, not "one database per service."
#
# The per-service <SERVICE>_MONGO_URI / <SERVICE>_MONGO_DB_NAME vars are OPTIONAL
# overrides — leave them blank unless you deliberately want one service on a
# different cluster/database. Leave MONGO_URI blank too → every service falls
# back to an in-memory store (dev/CI only; nothing persists across restarts).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=portless

# ---------------------------------------------------------------------------
# Trade-Min MongoDB (opportunity persistence)
# ---------------------------------------------------------------------------
# TRADE_MONGO_URI=          # optional override of MONGO_URI
# TRADE_MONGO_DB_NAME=      # optional override of MONGO_DB_NAME
TRADE_MONGO_COLLECTION=opportunities

# Mock mode — bypasses every live trade-intelligence connector (Comtrade,
# Census, Alibaba RFQ, GDELT, EU TED, WITS/Access2Markets, IndiaMART,
# TradeIndia) with curated scenario data (services/trade_min/mock_data.py) so
# both manual POST /trade-min/scan calls and the APScheduler nightly/reorder
# jobs stay instant and network-free. Set to false (or unset) to hit the live
# APIs configured above.
# TRADE_MIN_MOCK_MODE=false

# Raw third-party API response cache (conserves Comtrade/MacMap quota).
# Cached responses live in this collection (same shared DB) with a TTL index;
# falls back to in-memory when TRADE_MONGO_URI/MONGO_URI is absent. Per-connector
# TTLs are set in code (services/trade_min/config.py: cache_ttl_seconds). Named
# distinctly from the app-wide cache's collection below since both share one DB.
# Set TRADE_CACHE_ENABLED=0 to bypass the cache and always hit the live API.
TRADE_CACHE_COLLECTION=trade_api_cache
TRADE_CACHE_ENABLED=1

# ---------------------------------------------------------------------------
# Application-wide MongoDB cache (shared.cache)
# ---------------------------------------------------------------------------
# One TTL-indexed cache any module can use for READ-ONLY/idempotent results
# (regulatory verification, VIES, tariffs, LLM responses). Never caches
# mutating/financial ops. Falls back to in-memory if Mongo is unreachable.
CACHE_ENABLED=1
# CACHE_MONGO_URI=          # optional override of MONGO_URI
# CACHE_MONGO_DB_NAME=      # optional override of MONGO_DB_NAME
CACHE_COLLECTION=api_cache

# ---------------------------------------------------------------------------
# Deals MongoDB (deal lifecycle persistence)
# ---------------------------------------------------------------------------
# DEALS_MONGO_URI=          # optional override of MONGO_URI
# DEALS_MONGO_DB_NAME=      # optional override of MONGO_DB_NAME
DEALS_MONGO_COLLECTION=deals

# ---------------------------------------------------------------------------
# Sourcing MongoDB (RFQ + quote persistence)
# ---------------------------------------------------------------------------
# SOURCING_MONGO_URI=       # optional override of MONGO_URI
# SOURCING_MONGO_DB_NAME=   # optional override of MONGO_DB_NAME
SOURCING_RFQ_COLLECTION=rfqs
SOURCING_QUOTES_COLLECTION=quotes

# ---------------------------------------------------------------------------
# Auth — Portless platform-staff allowlist
# ---------------------------------------------------------------------------
# Comma-separated list of emails treated as Portless platform staff at
# signup (services/auth/organization.py::is_portless_user). No domain
# matching — an email either is or isn't on this list. Portless staff can:
#   - manage organizations + assign users to them (POST/GET /auth/organizations,
#     GET /auth/users, PATCH /auth/users/{id}/organization)
#   - use the Knowledge Base (/rag/*)
#   - see data across every organization (bypasses org-scoped filtering)
# Everyone else starts with no organization (org_id unset) until a Portless
# admin assigns one via the Organizations admin UI.
AUTH_PORTLESS_EMAILS=admin@portless.io,ops@portless.io

# ---------------------------------------------------------------------------
# Indian Government API Gateway (API Setu) — GSTN + DGFT + MCA + Udyam verification
# ---------------------------------------------------------------------------
# One key covers GSTN (GST Network), DGFT (Importer-Exporter Code), MCA21
# (company registry), and Udyam (MSME).
#   Registration  : https://apisetu.gov.in → Create developer account
#                   → Apply for GSTN / DGFT / MCA / Udyam API products
#   Sandbox mode  : set GSTN_USE_SANDBOX=1 / DGFT_USE_SANDBOX=1 for sandbox endpoints
API_SETU_KEY=your_api_setu_key_here
API_SETU_CLIENT_ID=your_api_setu_client_id_here

# Allianz Trade (Euler Hermes) — buyer credit risk & trade credit insurance
#   Registration  : https://developer.allianz-trade.com → Create app
ALLIANZ_TRADE_CLIENT_ID=your_allianz_trade_client_id_here
ALLIANZ_TRADE_CLIENT_SECRET=your_allianz_trade_client_secret_here
ALLIANZ_TRADE_WEBHOOK_SECRET=your_allianz_trade_webhook_secret_here

# ---------------------------------------------------------------------------
# Negotiation Agent — LLM (via shared LLM Gateway)
# ---------------------------------------------------------------------------
# Every LLM call in the app goes through shared.llm_gateway.LLMClient / .embeddings
# .GatewayEmbeddings — model selection, API keys, fallback chain, embeddings, and
# tracking are ALL configured in backend/shared/llm_gateway/.env, not here.
#
# Do NOT set LLM_GROQ_API_KEY / LLM_PRIMARY_* / LLM_EMBEDDING_* in this file.
# shared/config.py's load_dotenv(..., override=False) populates the real process
# environment from THIS file first, and pydantic-settings always prefers a real
# env var over a module-local dotenv value — so a placeholder left here would
# silently shadow the real key set in shared/llm_gateway/.env. Copy
# shared/llm_gateway/.env.example to .env there and fill it in instead.

# Per-call generation overrides used by the Negotiation Agent (kept low for
# deterministic routing decisions and predictable price counters).
NEGOTIATION_LLM_TEMPERATURE=0.3
NEGOTIATION_LLM_MAX_TOKENS=2048

# LLM response cache (shared MongoDB TTL cache). Off by default. When enabled,
# identical (messages, model, temperature) requests are served from cache to cut
# token spend. Keep the TTL short so live prices never go stale mid-negotiation.
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Negotiation Agent — MongoDB persistence
# ---------------------------------------------------------------------------
# NEGOTIATION_MONGO_URI=    # optional override of MONGO_URI
# NEGOTIATION_MONGO_DB_NAME= # optional override of MONGO_DB_NAME
NEGOTIATION_SESSIONS_COLLECTION=sessions
NEGOTIATION_ROUNDS_COLLECTION=rounds

# ---------------------------------------------------------------------------
# Email Gateway — email transport: single IMAP + single SMTP config (port 8012)
# ---------------------------------------------------------------------------
# One service owns all credentialed email I/O. It monitors/fetches inbound mail
# over IMAP (automatic, every 15 min) and forwards it to the Email Processor;
# it sends outbound mail over SMTP via POST /email-gateway/send (called by the
# negotiation flow after HITL approval).
#
# Gmail setup (one account serves both IMAP and SMTP):
#   1. Enable IMAP: Settings → Forwarding and POP/IMAP → Enable IMAP
#   2. Enable 2-Step Verification: https://myaccount.google.com/security
#   3. Create an App Password: https://myaccount.google.com/apppasswords
#      Use it for BOTH IMAP_PASSWORD and GMAIL_APP_PASSWORD.
#
# --- Inbound (IMAP) --- leave IMAP_USER empty to disable polling.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-portless-gmail@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=900   # 15 minutes
# Optional dedicated Gmail labels to segregate buyer vs supplier replies.
IMAP_BUYER_FOLDER=INBOX
IMAP_SUPPLIER_FOLDER=INBOX

# --- Outbound (SMTP) --- same Gmail account; leave GMAIL_SENDER_ADDRESS empty
# → outbound messages are logged only (dev/CI mode).
GMAIL_SENDER_ADDRESS=your-portless-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=PortLess Trade Agent
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Forward mode. false (default) = the gateway forwards fetched emails in-process
# to the Email Processor. true = the gateway POSTs each email to the Processor's
# receiving API (POST /email-processor/inbound) — use to run the two apart.
FORWARD_VIA_HTTP=false
EMAIL_GATEWAY_URL=http://localhost:8012

# ---------------------------------------------------------------------------
# Email Processor — inbound processing + persistence (services, port 8013)
# ---------------------------------------------------------------------------
# Receives fetched/pushed emails (from the Gateway's IMAP forward, provider
# webhooks, or manual submission), matches each to a LIVE negotiation, extracts
# the counter-price, persists an audit record, and triggers the orchestration.
#
# MongoDB (falls back to MONGO_URI, then to in-memory when unset).
# EMAIL_PROCESSOR_MONGO_URI=     # optional override of MONGO_URI
# EMAIL_PROCESSOR_MONGO_DB_NAME= # optional override of MONGO_DB_NAME
EMAIL_PROCESSOR_INBOUND_COLLECTION=inbound_emails
EMAIL_PROCESSOR_URL=http://localhost:8013

# PortLess trade identity + price-extraction bounds.
PORTLESS_EMAIL_DOMAIN=portless.io
PORTLESS_TRADE_ADDRESS=portless-trade@portless.io
PRICE_EXTRACTION_MIN=0.01
PRICE_EXTRACTION_MAX=10000000

# Optional provider webhooks (alternatives to IMAP polling; posted to the Processor).
SENDGRID_WEBHOOK_PUBLIC_KEY=
MAILGUN_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Negotiation Agent — session locks
# ---------------------------------------------------------------------------
# Single-instance dev uses an in-memory dict. For multi-replica deployments the
# shared MongoDB cache (see CACHE_* above) is the lock store — no Redis needed.

# ---------------------------------------------------------------------------
# DealMaker / DocuGen — generated document storage (PI/PO, CI/PL/CoO/SDF/Shipping Bill)
# ---------------------------------------------------------------------------
# Google Drive is the PRIMARY document store: each rendered document is
# uploaded to "<GOOGLE_DRIVE_ROOT_FOLDER>/<deal_id>/<filename>" in your own
# Google Drive (shared/connectors/google_drive.py). Local disk
# (DEALMAKER_STORAGE_DIR / DOCUGEN_STORAGE_DIR, default
# <OS temp dir>/portless-docs/<service> — works on both Unix and Windows
# without admin rights) is an emergency fallback only, used when the Drive
# vars are unset or an upload fails — every local write logs a loud warning.
#
# Drive's API has no username/password auth, so this uses an OAuth2 refresh
# token instead of a login:
#   1. https://console.cloud.google.com/apis/credentials → enable "Google
#      Drive API" → Create Credentials → OAuth client ID → "Desktop app".
#   2. Copy the Client ID / Client Secret below.
#   3. Run: cd backend && python scripts/google_drive_authorize.py
#      (opens a browser for one-time consent; scope is drive.file — it can
#      only see/edit files this app creates, not your whole Drive) and paste
#      the printed GOOGLE_DRIVE_REFRESH_TOKEN back here.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER=Portless
