      "updated": 1792389866279,
      "link": null,
      "locked": false,
      "text": "⑨ Production config gate\n\nENV_PROFILE=production refuses to boot with stub connectors, log-only email, in-process bus, missing webhook secrets, TRADE_MIN_MOCK_MODE or\nAUTO_FLOW_ENABLED. Today the pipeline would happily 'complete' a deal against stubs.\n\nCloses P1-1 · 5.C",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "debNSh2elLv8y9suyPS5",
      "originalText": "⑨ Production config gate\n\nENV_PROFILE=production refuses to boot with stub connectors, log-only email, in-process bus, missing webhook secrets, TRADE_MIN_MOCK_MODE or\nAUTO_FLOW_ENABLED. Today the pipeline would happily 'complete' a deal against stubs.\n\nCloses P1-1 · 5.C",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b3s"
    },
