    {
      "id": "FvDHYU9v6QAATbyjvTLR",
      "type": "text",
      "x": 2280,
      "y": 1194,
      "width": 1070,
      "height": 129.375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
