    {
      "id": "OjcpI6m2wqlhTYcbGimn",
      "type": "text",
      "x": 1360,
      "y": 1194,
      "width": 840,
      "height": 143.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
