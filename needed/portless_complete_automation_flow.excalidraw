    {
      "id": "ZlkhjfBSYrH7lUKW6PwS",
      "type": "text",
      "x": 4810,
      "y": 1194,
      "width": 840,
      "height": 115,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
