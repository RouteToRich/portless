    {
      "id": "dDl3FYMieSUd5fCv5Knv",
      "type": "text",
      "x": 3430,
      "y": 1194,
      "width": 1300,
      "height": 115,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
