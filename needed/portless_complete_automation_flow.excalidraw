    {
      "id": "4FlG4lXYh4mOqG9phOBf",
      "type": "text",
      "x": 5730,
      "y": 1194,
      "width": 610,
      "height": 129.375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
