# PortLess service registry — base URLs used by inter-service REST clients.
#
# DEVELOPMENT (combined monolith on port 8081):
#   Run:  cd backend && uvicorn app:app --reload --port 8081
#   All modules are reachable at http://localhost:8081/<module-prefix>/...
#   The UI dev proxy rewrites /api -> http://localhost:8081
#
# PRODUCTION (each service on its own port — see docker-compose.yml):
#   Uncomment and set the individual service URLs below.

# --- Combined dev server (used by UI proxy) ---
COMBINED_URL=http://localhost:8081

# --- Individual service URLs (microservice / production mode) ---
API_GATEWAY_URL=http://localhost:8000
DEALS_URL=http://localhost:8001
TRADE_MIN_URL=http://localhost:8002
MATCH_ENGINE_URL=http://localhost:8003
SOURCING_URL=http://localhost:8004
NEGOTIATION_AGENT_URL=http://localhost:8005
DEALMAKER_URL=http://localhost:8006
SHIELD_LINK_URL=http://localhost:8007
DOCUGEN_URL=http://localhost:8008
ESCROW_GUARD_URL=http://localhost:8009
HITL_APPROVAL_URL=http://localhost:8010
EXCEPTION_RESOLVER_URL=http://localhost:8011

# Cross-cutting
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Trade-intelligence connector credentials
# ---------------------------------------------------------------------------
# UN Comtrade – Global trade volumes, HS code flow data, YoY demand growth
#   Registration : FREE tier available (500 calls/day, 100K records/call)
#     1. Create account : https://comtradeplus.un.org
#     2. Developer portal: https://comtradedeveloper.un.org
#     3. Products → Free APIs → Subscribe (auto-approved)
#     4. Key at: /profile → Show keys
#   Premium      : auto-issued on developer portal login; email comtrade@un.org
#   Docs         : https://uncomtrade.org/docs/un-comtrade-api/
COMTRADE_SUBSCRIPTION_KEY=your_comtrade_subscription_key_here

# --- FREE replacements (active in the default pipeline) ----------------------
# World Bank WITS (TRAINS) – applied import tariffs at HS-6 (Phase 3 tariff gate).
#   Replaces the paid ITC MacMap. NO KEY / NO REGISTRATION required — fully open.
#   Docs : https://wits.worldbank.org/witsapiintro.aspx
# (no env var needed)

# US Census International Trade – free US import statistics (Phase 1, US market).
#   HOW TO GET KEY (free, instant):
#     1. Request a key at https://api.census.gov/data/key_signup.html
#     2. Click the activation link in the confirmation email
#     3. Paste the key below
#   Docs : https://www.census.gov/data/developers/data-sets/international-trade.html
CENSUS_API_KEY=your_census_api_key_here

# EU Access2Markets – EU tariffs + NTBs + rules of origin (Phase 3, EU markets).
#   Preferred over WITS for EU destinations (richer NTB / rules-of-origin data).
#   The official portal API is not openly documented, so the production endpoint
#   is supplied here once confirmed (early-access / portal inspection). When left
#   empty, EU tariffs transparently fall back to the free WITS connector.
#   URL template — use {reporter} {partner} {product} placeholders, e.g.
#     https://trade.ec.europa.eu/access-to-markets/api/.../{partner}/{reporter}/{product}
#   Docs : https://trade.ec.europa.eu/access-to-markets
ACCESS2MARKETS_API_URL=
ACCESS2MARKETS_API_KEY=

# Alibaba International B2B – active buyer RFQ / live buying-intent feed
#   Registration : https://developer.alibaba.com → Create App
#                  → Apply for "International Trade" API product
#   Docs         : https://developer.alibaba.com
ALIBABA_APP_KEY=your_alibaba_app_key_here
ALIBABA_APP_SECRET=your_alibaba_app_secret_here

# --- LEGACY / PAID (retired from the default pipeline; optional) -------------
# These are no longer called by default — the free sources above replace them.
# Set a key only to re-enable the connector (see workflow-implementation.md →
# "Replaced / Legacy Trade-Min connectors").
#
# Volza (PAID $0.10/search + $0.02/record) – named buyers from BoL manifests
#   Registration : app.volza.com → API Settings → Generate Key
VOLZA_API_KEY=your_volza_api_key_here
# ITC Market Access Map (PAID subscription) – superseded by WITS
#   Registration : https://macmap.org/tools/macmap-api
MACMAP_API_KEY=your_macmap_api_key_here
# Trademo Intel (PAID) – supply-chain records, buyer risk profiling
TRADEMO_API_KEY=your_trademo_api_key_here
# ImportGenius / Panjiva (PAID, enterprise) – US/LatAm marine manifests
IMPORTGENIUS_API_KEY=your_importgenius_api_key_here

# IndiaMART – India's largest wholesale B2B directory (seller discovery)
#   Registration : seller.indiamart.com → API Settings → Generate Key
#   Docs         : https://seller.indiamart.com/lmsrest/
INDIAMART_API_KEY=your_indiamart_api_key_here
INDIAMART_MOBILE=your_registered_mobile_number_here

# TradeIndia – fallback wholesale directory for supplier profiles
#   Registration : tradeindia.com → API access → Generate Bearer token
TRADEINDIA_API_KEY=your_tradeindia_api_key_here

# EU TED (Tenders Electronic Daily) – EU institutional procurement notices
#   Registration : None required — fully open API
#   Docs         : https://ted.europa.eu/api/v3.0/
# (no key needed — add to env only if a proxy/token is required in future)

# GDELT Project – supply-chain disruption news monitor
#   Registration : None required — fully open API
#   Docs         : https://api.gdeltproject.org/api/v2/doc/doc
# (no key needed)

# ---------------------------------------------------------------------------
# PortLess-owned Apify actors — buyer / seller identification + enrichment
# ---------------------------------------------------------------------------
# PortLess generates and publishes its own actors (Apify account `rich_minds`,
# built with /actor-pipeline in C:/workArea/pandian/apify-actors). One connector
# (backend/shared/connectors/apify.py) runs them all:
#   export-market-finder-ai    Phase 1 demand + the market's real unit value/MT
#   us-importer-finder-ai      Phase 2 named US buyers (customs records)
#   alibaba-rfq-leads-ai       Phase 2 live buying requests
#   india-supplier-finder-ai   Phase 4 Indian suppliers (generate with /actor-pipeline)
#   company-contact-finder-ai  deal enrichment: website / checked e-mail / phone / VAT
#   counterparty-check-ai      deal enrichment: OFAC/UN/EU/UK sanctions, LEI, VIES
#   email-list-qualifier-ai    deal enrichment: e-mail deliverability
# Without a token every actor returns an empty result (parties stay
# "unchecked" / "unverified" — the UI shows it; the readiness check flags it).
#   Token: https://console.apify.com/account/integrations. When unset the
#   backend also reads ~/.apify/auth.json (the Apify CLI login) unless
#   APIFY_TOKEN_AUTODISCOVER=false. NEVER commit the token.
APIFY_TOKEN=
# APIFY_TOKEN_AUTODISCOVER=true
# Apify REST API root — change only to route through a proxy or a mock server.
# APIFY_BASE_URL=https://api.apify.com/v2
APIFY_ACTOR_OWNER=rich_minds
# Per-actor override: a slug, owner~slug or an actor id (defaults: owner~<slug above>)
# APIFY_ACTOR_US_IMPORTER_FINDER=
# APIFY_ACTOR_ALIBABA_RFQ_LEADS=
# APIFY_ACTOR_EXPORT_MARKET_FINDER=
# APIFY_ACTOR_INDIA_SUPPLIER_FINDER=
# APIFY_ACTOR_COMPANY_CONTACT_FINDER=
# APIFY_ACTOR_COUNTERPARTY_CHECK=
# APIFY_ACTOR_EMAIL_LIST_QUALIFIER=
# Cost controls: AI tier (fit score + reason + pitch) vs rules; rows per call
# (25 = each actor's free units); wall-clock budget per run; cap on what a
# source Store actor may charge the account in one run.
# APIFY_ENABLE_AI=true
# APIFY_MAX_ITEMS=25
# APIFY_RUN_TIMEOUT_SECONDS=240
# APIFY_MAX_DISCOVERY_CHARGE_USD=0.5
# Daily run budget across scans, enrichment and carrier tracking (0 = unlimited).
# A mis-fired schedule cannot burn the account past this; readiness warns when unset.
# APIFY_MAX_RUNS_PER_DAY=40
# Carrier / container tracking (DELIVERED opens the buyer's acceptance window).
# multi-carrier-tracking-ai looks containers up through the public carrier Store
# Actors (MSC, Maersk ...): a plan that cannot run public Actors gets
# source_refused (poll status + readiness warning) - upgrade the plan, use the
# forwarder webhook, or record milestones by hand.
# APIFY_ACTOR_CARRIER_TRACKING=multi-carrier-tracking-ai
# HMAC secret the actors sign their webhookUrl POSTs with (X-Signature: sha256=…)
# APIFY_WEBHOOK_SECRET=
# Counterparty identification + screening at deal creation (continuations):
# ENRICHMENT_ON_DEAL_CREATED=true
# Buyer / supplier check at scan time (services/trade_min/validation.py): sanctions,
# e-mail and GST / IEC for the top N per role of each opportunity — the radar's
# "Verified only" view shows only the ones that passed. Each check is a paid Apify run;
# a result is reused for MAX_AGE_DAYS.
# TRADE_MIN_VALIDATION_ENABLED=true
# TRADE_MIN_VALIDATION_TOP_N=5
# TRADE_MIN_VALIDATION_MAX_AGE_DAYS=30
# Before a deal is created from an opportunity, fill its best pairs' gaps (check, supplier
# address / GSTIN, port distance, estimated supplier price) and rescore (trade_min/rescore.py)
# DEAL_RESCORE_BEFORE_CREATE=true

# Trade compliance — PortLess is exporter of record (shared/orchestration/compliance.py)
# COMPLIANCE_ENABLED=true
# COMPLIANCE_LOADING_CHECK_REQUIRED=true
# COMPLIANCE_UNCHECKED_SCREENING=review
# COMPLIANCE_BLOCKED_COUNTRIES=KP,IR,SY,CU
# COMPLIANCE_PRICE_DEVIATION_PCT=40
# COMPLIANCE_MAX_SPREAD_RATIO=1.8
# COMPLIANCE_QTY_TOLERANCE_PCT=5
# COMPLIANCE_MIN_COMPANY_AGE_YEARS=1

# ---------------------------------------------------------------------------
# Optional live market intelligence (Tavily)
# ---------------------------------------------------------------------------
#   Registration : https://app.tavily.com → Sign up → API Keys
#   Docs         : https://docs.tavily.com/documentation/api-reference/endpoint/search
TAVILY_API_KEY=your_tavily_api_key_here

# Consumed by the Negotiation Agent's live market-context leg (buyer/supplier
# pricing & demand color pulled fresh before each drafted email), controlled by
# NEGOTIATION_MARKET_SEARCH_ENABLED in agents/negotiation_agent/config.py.
# Off by default; no key means no network call. Retrieved snippets are screened
# before reaching any drafting prompt. Every drafted email is still routed
# through the existing L0 HITL approval gate.
# NEGOTIATION_MARKET_SEARCH_ENABLED=true

# ===========================================================================
# MongoDB — ONE connection string + ONE database for the whole application
# ===========================================================================
# Set MONGO_URI and MONGO_DB_NAME once — EVERY service/module persists into that
# single database, each via its own collection(s) (deals, opportunities, rfqs,
# quotes, llm_requests, …), so nothing collides. This is a genuinely
# single-database deployment, not "one database per service."
#
# The per-service <SERVICE>_MONGO_URI / <SERVICE>_MONGO_DB_NAME vars are OPTIONAL
# overrides — leave them blank unless you deliberately want one service on a
# different cluster/database. Leave MONGO_URI blank too → every service falls
# back to an in-memory store (dev/CI only; nothing persists across restarts).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=portless

# ===========================================================================
# Shared LLM Gateway — every LLM call, same integration as makemerich-backend
# ===========================================================================
# shared.llm_gateway sends every chat call to the RouteToRich LLM
# Gateway through the API gateway's /api/llm route (shared/llm_gateway/remote.py).
# Model routing, fallback, provider keys and cost metering live in the gateway —
# PortLess holds no Groq / OpenAI / Anthropic / Gemini key at all.
# Leave LLM_GATEWAY_URL blank → chat() raises (negotiation drafts degrade to
# templates, the resolver escalates).
#
# NOTE: this is NOT API_GATEWAY_URL above — that one is PortLess's own edge
# service (services/api_gateway, port 8000).
LLM_GATEWAY_URL=https://api-gateway-two-nu.vercel.app
#
# Credential — PortLess calls the LLM from background event handlers (no user
# request to borrow a token from), so it signs in to auth-service as its own
# service account: POST <LLM_GATEWAY_URL>/auth/login, bearer cached and
# refreshed before the 1 h expiry and on a 401. Register the account through
# the gateway once; LLM_GATEWAY_ACCOUNT_ID is PortLess's app account id.
LLM_GATEWAY_EMAIL=
LLM_GATEWAY_PASSWORD=
LLM_GATEWAY_ACCOUNT_ID=
# …or a pre-minted bearer instead of email/password (no sign-in, no refresh):
# LLM_GATEWAY_TOKEN=
# LLM_GATEWAY_TIMEOUT_SECONDS=120
# LLM_GATEWAY_CALLER_PREFIX=portless   # caller tag "portless.<caller>" in gateway stats

# ---------------------------------------------------------------------------
# Trade-Min MongoDB (opportunity persistence)
# ---------------------------------------------------------------------------
# TRADE_MONGO_URI=          # optional override of MONGO_URI
# TRADE_MONGO_DB_NAME=      # optional override of MONGO_DB_NAME
TRADE_MONGO_COLLECTION=opportunities

# Dev/test auto-continuation (shared/orchestration/auto_flow.py): an
# opportunity-seeded deal auto-advances through sourcing → negotiation → PI →
# escrow; PO/freight/payout still stop at HITL. Never enable in production.
# AUTO_FLOW_ENABLED=false

# Raw third-party API response cache (conserves Comtrade/MacMap quota).
# Cached responses live in this collection (same shared DB) with a TTL index;
# falls back to in-memory when TRADE_MONGO_URI/MONGO_URI is absent. Per-connector
# TTLs are set in code (services/trade_min/config.py: cache_ttl_seconds). Named
# distinctly from the app-wide cache's collection below since both share one DB.
# Set TRADE_CACHE_ENABLED=0 to bypass the cache and always hit the live API.
TRADE_CACHE_COLLECTION=trade_api_cache
TRADE_CACHE_ENABLED=1

# ---------------------------------------------------------------------------
# Application-wide MongoDB cache (shared.cache)
# ---------------------------------------------------------------------------
# One TTL-indexed cache any module can use for READ-ONLY/idempotent results
# (regulatory verification, VIES, tariffs, LLM responses). Never caches
# mutating/financial ops. Falls back to in-memory if Mongo is unreachable.
CACHE_ENABLED=1
# CACHE_MONGO_URI=          # optional override of MONGO_URI
# CACHE_MONGO_DB_NAME=      # optional override of MONGO_DB_NAME
CACHE_COLLECTION=api_cache

# ---------------------------------------------------------------------------
# Deals MongoDB (deal lifecycle persistence)
# ---------------------------------------------------------------------------
# DEALS_MONGO_URI=          # optional override of MONGO_URI
# DEALS_MONGO_DB_NAME=      # optional override of MONGO_DB_NAME
DEALS_MONGO_COLLECTION=deals

# ---------------------------------------------------------------------------
# Sourcing MongoDB (RFQ + quote persistence)
# ---------------------------------------------------------------------------
# SOURCING_MONGO_URI=       # optional override of MONGO_URI
# SOURCING_MONGO_DB_NAME=   # optional override of MONGO_DB_NAME
SOURCING_RFQ_COLLECTION=rfqs
SOURCING_QUOTES_COLLECTION=quotes

# ---------------------------------------------------------------------------
# Sign-in — auth-service through the shared RouteToRich API gateway
# ---------------------------------------------------------------------------
# PortLess issues no tokens: users sign up / sign in at auth-service (the UI
# calls the gateway's /auth/*), like MakeMeRich. Every request's bearer token is
# checked with the gateway's GET /auth/me (shared/auth/identity.py, cached 60 s).
#
# The gateway whose /auth/me checks tokens. Defaults to LLM_GATEWAY_URL (same gateway).
# AUTH_GATEWAY_URL=https://api-gateway-two-nu.vercel.app
# PortLess's app account in auth-service (account-management console). A token
# scoped to any other application is refused with 403. Defaults to
# LLM_GATEWAY_ACCOUNT_ID (same value). Unset → any application's sign-in is
# accepted and the readiness gate fails in production.
PORTLESS_ACCOUNT_ID=
# true → believe the gateway's X-User-* headers without checking the token
# (MakeMeRich's model). ONLY when nothing but the gateway can reach this service.
# AUTH_TRUST_GATEWAY_HEADERS=false
# AUTH_INTROSPECTION_CACHE_SECONDS=60
# The deployed console's origin — the approvals SSE stream is opened against this
# backend directly, so it must pass CORS.
# FRONTEND_URL=https://portless-ui.vercel.app

# Comma-separated list of emails treated as Portless platform staff
# (services/auth/organization.py::is_portless_user). No domain matching — an
# email either is or isn't on this list. Register these addresses in the
# PortLess app account yourself before anyone else can. Portless staff can:
#   - manage organizations + assign users to them (POST/GET /identity/organizations,
#     GET /identity/users, PATCH /identity/users/{id}/organization)
#   - see data across every organization (bypasses org-scoped filtering)
# Everyone else starts with no organization (org_id unset) the first time they
# reach PortLess, until a Portless admin assigns one via the Organizations admin UI.
AUTH_PORTLESS_EMAILS=admin@portless.io,ops@portless.io

# ---------------------------------------------------------------------------
# Indian Government API Gateway (API Setu) — GSTN + DGFT + MCA + Udyam verification
# ---------------------------------------------------------------------------
# One key covers GSTN (GST Network), DGFT (Importer-Exporter Code), MCA21
# (company registry), and Udyam (MSME).
#   Registration  : https://apisetu.gov.in → Create developer account
#                   → Apply for GSTN / DGFT / MCA / Udyam API products
#   Sandbox mode  : set GSTN_USE_SANDBOX=1 / DGFT_USE_SANDBOX=1 for sandbox endpoints
API_SETU_KEY=your_api_setu_key_here
API_SETU_CLIENT_ID=your_api_setu_client_id_here

# Allianz Trade (Euler Hermes) — buyer credit risk & trade credit insurance
#   Registration  : https://developer.allianz-trade.com → Create app
ALLIANZ_TRADE_CLIENT_ID=your_allianz_trade_client_id_here
ALLIANZ_TRADE_CLIENT_SECRET=your_allianz_trade_client_secret_here
ALLIANZ_TRADE_WEBHOOK_SECRET=your_allianz_trade_webhook_secret_here

# ---------------------------------------------------------------------------
# Live or sandbox — QC inspection, freight + customs, escrow + payouts
# ---------------------------------------------------------------------------
# One implementation serves the real workflow and the automated one
# (shared/integration_mode.py):
#   live    (default) every QC / freight / customs / escrow / payout call goes to
#           the real provider with the keys below. A key still holding its
#           your_..._here placeholder is sent as-is, the provider refuses it and
#           the step fails visibly (deal.exception) — replace the placeholder
#           with the real key and that provider works, nothing else to change.
#   sandbox stubs + the QC simulator. Set ONLY by the automation worker and the
#           test suite; readiness fails in production while it is set.
INTEGRATION_MODE=live

# ---------------------------------------------------------------------------
# Shield-Link — QC inspection providers (buyer-selectable, top-5)
# ---------------------------------------------------------------------------
# All five are globally accepted, available in India, and deliver photo (SGS &
# QIMA also video) documented inspection reports. Connectors live in
# backend/shared/connectors/qc_providers.py; without a key each returns a
# realistic stub so the deal pipeline advances in dev/CI. The buyer's opted
# provider is captured during negotiation and used at QC booking time.
# Catalog: GET /shield-link/qc/providers · Quote: POST /shield-link/qc/quote
#
# Full flow and timing: docs/integrations/QC_INSPECTION.md
#
# Providers PortLess books today (comma list or "all"). Only QIMA has a live API
# integration; SGS / BV / Intertek / TUV SUD stay in the code, dormant. A buyer who
# names another inspector is booked with QIMA; asking for another explicitly is refused.
QC_PROVIDERS_ENABLED=qima
#
# QIMA — public REST API (https://developers.qima.com). Booking POST
# /v1.0/inspection, status polled (no webhook), report PDF downloaded, cancel.
# Ask QIMA sales / IT for the Ai-Api-Access-Token and a client account; the
# password is sent MD5-hashed (QIMA_PASSWORD hashed for you, or QIMA_PASSWORD_MD5).
QIMA_API_ACCESS_TOKEN=your_qima_api_access_token_here
QIMA_ACCOUNT=your_qima_account_here
QIMA_PASSWORD=your_qima_password_here
QIMA_PASSWORD_MD5=
# Documented pre-production host; QIMA gives the production host + Referer.
QIMA_BASE_URL=https://ppapi.qima.com
QIMA_REFERER=https://preprodmy.qima.com/
QIMA_SERVICE_TYPE=1                 # 1 = PSI (pre-shipment inspection)
# Product category / family / type ids from GET /parameter/v2/product-tree (required to book)
QIMA_PRODUCT_CATEGORY_ID=your_qima_product_category_id_here
QIMA_PRODUCT_FAMILY_ID=your_qima_product_family_id_here
QIMA_PRODUCT_TYPE_ID=your_qima_product_type_id_here
QIMA_SAMPLE_LEVEL=II
QIMA_AQL_CRITICAL=0
QIMA_AQL_MAJOR=2.5
QIMA_AQL_MINOR=4.0
QIMA_ALLOW_DATE_CHANGE=true
QIMA_WEBHOOK_SECRET=your_qima_webhook_secret_here
# SGS (default) — SGS SMART is a customer portal: no public booking / status /
# report API. The booking request is e-mailed to the SGS booking desk (or
# entered on SGS SMART by staff); the confirmation and report come back on
# POST /shield-link/qc/webhook (x-sgs-signature) or POST /shield-link/qc/{ref}/status.
SGS_BOOKING_EMAIL=your_sgs_booking_email_here
SGS_WEBHOOK_SECRET=your_sgs_webhook_secret_here
# Bureau Veritas — BV OneSource Connect (app.onesourceconnect.com) portal, same channel as SGS.
BUREAU_VERITAS_BOOKING_EMAIL=your_bureau_veritas_booking_email_here
BUREAU_VERITAS_WEBHOOK_SECRET=your_bureau_veritas_webhook_secret_here
# The buyer's packing (shared/orchestration/packing.py): asked before the agreement,
# passed to the supplier / PI / PO / inspector, and special packing priced until the
# supplier confirms its price includes it. USD estimates per MT or per container.
NEGOTIATION_PACKING_REQUIRED=true
# TRADE_COST_PACKING_PRINTED_BAGS_USD_PER_MT=6
# TRADE_COST_PACKING_JUTE_USD_PER_MT=18
# TRADE_COST_PACKING_SMALL_PACKS_USD_PER_MT=45
# TRADE_COST_PACKING_FIBC_USD_PER_MT=8
# TRADE_COST_PACKING_LINER_USD_PER_MT=5
# TRADE_COST_PALLETS_USD_PER_CONTAINER=220
# TRADE_COST_FUMIGATION_USD_PER_CONTAINER=60
# TRADE_COST_CONTAINER_LINING_USD_PER_CONTAINER=90
# TRADE_COST_FLEXIBAG_USD_PER_CONTAINER=300
# When the inspection happens (shared/orchestration/qc_schedule.py)
QC_READINESS_DATE_REQUIRED=true     # book only once the supplier names its goods-ready date
QC_FACILITY_ADDRESS_REQUIRED=true   # book only once the supplier's facility address (street, town, PIN) is known
QC_BOOKING_LEAD_BUSINESS_DAYS=2     # agency notice; never book sooner
QC_MIN_PACKED_PCT=80                # readiness rule: 100% produced, >= this % packed
QC_POLL_MINUTES=60                  # QIMA status poll (deal watcher)
QC_REPORT_GRACE_HOURS=48            # after the inspection day, before the supplier is chased
QC_SHIP_AFTER_INSPECTION_DAYS=7     # planned ship date sent with the booking
# Provider sandbox — tests and automation only; readiness FAILS in production while set.
# QC_SANDBOX_PROVIDERS=qima,sgs,bv  # or "all"; QC_SANDBOX_URL=http://localhost:8014 for `make qc-sandbox`
# Intertek — InterLink 2.0 "ready-to-integrate" APIs (commercial agreement).
INTERTEK_API_KEY=your_intertek_api_key_here
INTERTEK_BASE_URL=
INTERTEK_WEBHOOK_SECRET=your_intertek_webhook_secret_here
# TÜV SÜD — enterprise/customer-portal integration.
TUV_SUD_API_KEY=your_tuv_sud_api_key_here
TUV_SUD_BASE_URL=
TUV_SUD_WEBHOOK_SECRET=your_tuv_sud_webhook_secret_here

# ---------------------------------------------------------------------------
# Shield-Link — freight booking + customs (transportation management)
# ---------------------------------------------------------------------------
COGOPORT_API_KEY=your_cogoport_api_key_here
COGOPORT_WEBHOOK_SECRET=your_cogoport_webhook_secret_here
FREIGHTOS_API_KEY=your_freightos_api_key_here
FREIGHTOS_WEBHOOK_SECRET=your_freightos_webhook_secret_here
ICEGATE_API_KEY=your_icegate_api_key_here

# ---------------------------------------------------------------------------
# Escrow-Guard — neutral escrow (buyer funds) + supplier payouts
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Carrier — Maersk (docs/integrations/MAERSK.md). PortLess books the container,
# reads Track & Trace, submits the VGM and approves the draft B/L through Maersk.
# Developer portal: developer.maersk.com → create an app → Consumer Key + Secret.
FREIGHT_PROVIDER=maersk                       # maersk | cogoport | freightos (who books the shipment)
FREIGHT_QUOTE_PROVIDER=cogoport               # who quotes the lane for pricing
MAERSK_CONSUMER_KEY=your_maersk_consumer_key_here
MAERSK_CLIENT_SECRET=your_maersk_client_secret_here
MAERSK_CUSTOMER_CODE=your_maersk_customer_code_here
MAERSK_SERVICE_CONTRACT=your_maersk_service_contract_here
MAERSK_CARRIER_SERVICE_CODE=your_maersk_carrier_service_code_here   # the Maersk service on your lane (Schedules)
MAERSK_WEBHOOK_SECRET=your_maersk_webhook_secret_here               # register .../shield-link/carrier/maersk/webhook?token=<this>
MAERSK_DEFAULT_EQUIPMENT=42GP                 # ISO size-type when the gate names none
# MAERSK_BASE_URL=https://api.maersk.com
# MAERSK_TOKEN_URL=https://api.maersk.com/customer-identity/oauth/v2/access_token
# MAERSK_BOOKING_PATH=/dcsa/bkg/v2/bookings  MAERSK_EVENTS_PATH=/track-and-trace-private/events
# MAERSK_EBL_PATH=/dcsa/ebl/v3/transport-documents  MAERSK_VGM_PATH=/export-shipments/vgm/v1/shipments/{tdr}/vgm
# MAERSK_RATE_USD_PER_CONTAINER=              # contracted rate (Maersk quotes come from the contract)
# MAERSK_MT_PER_CONTAINER=25
# FREIGHT_POLL_MINUTES=60                     # booking / Track & Trace read for in-transit deals
# CARRIER_SANDBOX_PROVIDERS / CARRIER_SANDBOX_URL — carrier simulator, automation + tests only

# Inspection phases from the buyer's requirement (shared/orchestration/inspection_plan.py)
QC_DEFAULT_INSPECTION_TYPES=PSI               # any of DUPRO,PSI,PEO — PSI always included
QC_DUPRO_PRODUCTION_PCT=30                    # % produced at the during-production inspection
QC_DUPRO_DAYS_BEFORE_READY=10                 # DUPRO this many days before the goods-ready date
QIMA_SERVICE_TYPE_DUPRO=2                     # QIMA documented: 1 PSI, 2 DUPRO, 3 IPC, 4 CLC
QIMA_SERVICE_TYPE_PEO=                        # PEO has no documented QIMA id — ask QIMA for the account's id

# Neutral escrow — the buyer chooses Tazapay or Escrow.com (docs/integrations/ESCROW_PROVIDERS.md).
# PortLess never moves the money itself: each stage's proof goes to the provider,
# which pays it out (Tazapay after checking the documents; Escrow.com after the
# buyer accepts the milestone or its inspection period lapses).
ESCROW_PROVIDERS_ENABLED=tazapay,escrow_com   # what buyers may choose; readiness fails for one without keys
ESCROW_DEFAULT_PROVIDER=tazapay               # used when the buyer names none
# ESCROW_POLL_MINUTES=30                      # watcher re-reads escrows waiting on their provider
# Tazapay API v3 — https://developer.tazapay.com (Basic auth: API key + secret)
TAZAPAY_API_KEY=your_tazapay_api_key_here
TAZAPAY_API_SECRET=your_tazapay_api_secret_here
TAZAPAY_WEBHOOK_SECRET=your_tazapay_webhook_secret_here   # Settings > Webhooks > secret token
TAZAPAY_ENV=production                        # production → service.tazapay.com · sandbox → service-sandbox.tazapay.com
# TAZAPAY_BASE_URL=https://service.tazapay.com
# TAZAPAY_WEBHOOK_URL=https://<public-api-host>/escrow-guard/webhooks/tazapay   # sent with every escrow
# TAZAPAY_FEE_PCT=1.0
# TAZAPAY_RELEASE_EVENTS=escrow.verification.succeeded,escrow.released,escrow.release.succeeded
# Escrow.com API 2017-09-01 — https://www.escrow.com/api/docs (Basic auth: account e-mail + API key)
ESCROW_COM_API_KEY=your_escrow_com_api_key_here
ESCROW_COM_EMAIL=your_escrow_com_email_here
ESCROW_COM_WEBHOOK_SECRET=your_escrow_com_webhook_secret_here   # register .../webhooks/escrow-com?token=<this>
ESCROW_COM_ENV=production                     # production → api.escrow.com · sandbox → api.escrow-sandbox.com
# ESCROW_COM_BASE_URL=https://api.escrow.com/2017-09-01
# ESCROW_COM_INSPECTION_DAYS=1                # buyer's check per proof stage (the last stage uses the acceptance window)
# ESCROW_COM_FEE_PCT=0.89
# Release documents for the provider: a signed, expiring link to each stage's proof sheet
# PortLess's public API origin, reachable by Tazapay, e.g. https://api.portless.io
PORTLESS_PUBLIC_BASE_URL=
ESCROW_PROOF_LINK_SECRET=your_escrow_proof_link_secret_here
# ESCROW_PROOF_LINK_DAYS=30
# ESCROW_SANDBOX_PROVIDERS / ESCROW_SANDBOX_URL — provider simulator, automation + tests only
# Stripe Treasury (legacy buyer hold)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Payoneer (supplier payouts)
PAYONEER_CLIENT_ID=your_payoneer_client_id_here
PAYONEER_CLIENT_SECRET=your_payoneer_client_secret_here
PAYONEER_WEBHOOK_SECRET=your_payoneer_webhook_secret_here
# PAYONEER_BASE_URL=https://api.payoneer.com/v4

# Ocean freight is quoted (POST /shield-link/freight/quote) at negotiation
# start and priced into the CIF margin floor — buyer prices are CIF, supplier
# quotes Ex-Works. Set to false to restore the legacy logistics_cost=0
# behavior (margins then OVERSTATE by the freight cost — dev/demo only).
# NEGOTIATION_FREIGHT_COST_ENABLED=true

# USD→INR rate applied when the live FX fetch fails — margin math always
# needs a rate; the fallback is logged loudly.
# NEGOTIATION_FALLBACK_USD_INR_RATE=96.0

# Agreement completeness checklist: before NEGOTIATION_AGREED is declared, the
# orchestrator verifies required info is in hand (buyer's QC inspector choice,
# confirmed quantity) and otherwise drafts an email requesting it. Operator
# price override bypasses. Set false to close on price alone.
# NEGOTIATION_AGREEMENT_CHECKLIST_ENABLED=true

# Inbound price plausibility: an extracted counter-price outside
# [corridor_min/FACTOR, corridor_max*FACTOR] is treated as an extraction error
# (never becomes the working bid/ask; round flagged for HITL review).
# NEGOTIATION_PRICE_BAND_FACTOR=3.0

# Event-driven pipeline continuation:
# NEGOTIATION_AGREED automatically issues the PI (idempotent). Set false to
# fall back to manual / auto-flow-driven progression only.
# EVENT_CONTINUATION_ENABLED=true

# ---------------------------------------------------------------------------
# Autonomy policy — how much of the pipeline runs without a human
# ---------------------------------------------------------------------------
# Per-action autonomy level (L0 always ask · L1 ask with timeout · L2 auto +
# notify · L3 autonomous). Resolution: saved override (Autonomy Settings page /
# PUT /hitl-approval/autonomy-policy) → AUTONOMY_<ACTION> env → the deal's own
# autonomy_profile (PO / freight / customs / payout / tranche only) → built-in
# default. Built-in defaults: DISPATCH_RFQ=L2, SEND_DEAL_NOTIFICATION=L2,
# everything else L0. Example — hands-off negotiation + commercial steps:
# AUTONOMY_SEND_NEGOTIATION_EMAIL=L2
# AUTONOMY_CONFIRM_NEGOTIATION_AGREEMENT=L2
# AUTONOMY_CONFIRM_PI_ACCEPTANCE=L2
# AUTONOMY_CONFIRM_SUPPLIER_SELECTION=L1
# AUTONOMY_ISSUE_PO=L2
# AUTONOMY_BOOK_FREIGHT=L2
# AUTONOMY_FILE_CUSTOMS=L2
# Money movement (RELEASE_ESCROW_TRANCHE, RELEASE_SUPPLIER_PAYOUT,
# CONFIRM_BUYER_ACCEPTANCE) never resolves above this ceiling, whatever the
# policy or deal profile says (default L1):
# AUTONOMY_MONEY_CEILING=L1
# Gate policy v2 — per-action L1 timeout + on-timeout default, and value thresholds.
# An L1 gate auto-resolves with the action's default after its timeout
# (negotiation e-mails: 4h → APPROVE; money: 24h → REJECT; everything else: 24h → REJECT).
# AUTONOMY_SEND_NEGOTIATION_EMAIL_TIMEOUT_SECONDS=14400
# AUTONOMY_SEND_NEGOTIATION_EMAIL_ON_TIMEOUT=APPROVE
# A money gate whose amount is under the threshold becomes L2 — only while the
# leg's preconditions hold (proof refs present, ledger reconciled). Per action or global:
# AUTONOMY_RELEASE_ESCROW_TRANCHE_AUTO_APPROVE_BELOW_USD=10000
# AUTONOMY_MONEY_AUTO_APPROVE_BELOW_USD=
# Above FOUR_EYES_THRESHOLD_USD a money gate needs two different approvers and is
# never auto-approved (set it before any value threshold):
# FOUR_EYES_THRESHOLD_USD=25000
# Supplier selection without a click: GST + IEC checked and passed, quote inside
# the buyer's price corridor → CONFIRM_SUPPLIER_SELECTION resolves at L2.
# SOURCING_AUTO_SOURCE_VERIFIED=true
# Counterparty screening gate before the PI (review verdicts; block never asks):
# AUTONOMY_CONFIRM_COUNTERPARTY_RISK=L0
# Hard overrides no policy lifts: degraded/placeholder drafts stay L0, and the
# first outbound negotiation email stays L0 while HITL_ON_FIRST_OUTBOUND=true.
# HITL_ON_FIRST_OUTBOUND=true

# Counterparty notifications (templated PI / escrow funding / funding shortfall /
# PO / QC booking / shipment / arrival / inspection window / settlement /
# completion / reminder emails, gated by AUTONOMY_SEND_DEAL_NOTIFICATION —
# default L2 = sent immediately).
# DEAL_NOTIFICATIONS_ENABLED=true

# Deal SLA watcher — reminders + stall exceptions for deals waiting on the
# counterparty (PI not accepted, escrow not funded, status unchanged past SLA).
# DEAL_WATCHER_ENABLED=true
# DEAL_WATCHER_INTERVAL_SECONDS=600
# DEAL_PI_REMINDER_AFTER_HOURS=48
# DEAL_ESCROW_REMINDER_AFTER_HOURS=48
# DEAL_REMINDER_MAX=2
# DEAL_STALL_SLA_HOURS=168
# Supplier-side reminders (PO not acknowledged / inspection not produced):
# DEAL_PO_ACK_REMINDER_AFTER_HOURS=48
# DEAL_QC_READINESS_REMINDER_AFTER_HOURS=72

# Buyer outreach funnel — introduce PortLess to the identified buyers before
# the negotiation agent writes to them (SEND_BUYER_OUTREACH, default L2).
# OUTREACH_ENABLED=true
# OUTREACH_PARALLEL=2
# OUTREACH_FOLLOWUP_DAYS=3
# OUTREACH_NO_REPLY_DAYS=7

# Delivery → buyer acceptance window. "delivery" (default): the carrier's
# DELIVERED milestone (webhook, tracking actor poll, or an operator entry) opens
# the final-tranche window; "proof": the legacy behaviour (opens when the last
# proof tranche releases, while the goods are still at sea).
# INSPECTION_WINDOW_TRIGGER=delivery
# INSPECTION_WINDOW_MILESTONES=DELIVERED
# INSPECTION_WINDOW_FALLBACK_DAYS=21
# TRACKING_POLL_HOURS=12
# Hold back the same share of the supplier's money as the buyer's acceptance
# tranche (default 10 %) until the buyer accepts or the window lapses.
# SUPPLIER_RETENTION_ENABLED=true

# Exception playbooks — deterministic remediations before the LLM.
# EXCEPTION_PLAYBOOKS_ENABLED=true
# QC_REINSPECTION_MAX=1
# ESCROW_FUNDING_GRACE_DAYS=14

# Operator push + daily digest. Telegram: create a bot with @BotFather, put the
# operator (or an ops group) chat id here. Digest also goes by e-mail to
# DIGEST_EMAIL_TO (comma-separated) through the e-mail gateway.
# HITL_TELEGRAM_BOT_TOKEN=
# HITL_TELEGRAM_CHAT_ID=
# DAILY_DIGEST_ENABLED=true
# DIGEST_HOUR_UTC=06:00
# DIGEST_EMAIL_TO=

# Opportunity → deal auto-creation (production automation; off by default).
# Converts every OPPORTUNITY_DETECTED above the thresholds into a deal at
# MATCHING (then RFQ dispatch → negotiation …). Simulated-source opportunities
# are never converted; one deal per opportunity / live HS code × market.
# AUTO_DEAL_FROM_OPPORTUNITY_ENABLED=false
# AUTO_DEAL_MIN_ARBITRAGE_RANK=60
# AUTO_DEAL_MIN_CONFIDENCE=50
# AUTO_DEAL_OPERATOR_ID=system:auto-deal
# AUTO_DEAL_ORG_ID=portless
# AUTO_DEAL_AUTONOMY_PROFILE=L0

# ---------------------------------------------------------------------------
# Production readiness gate (shared/readiness.py, GET /health/readiness)
# ---------------------------------------------------------------------------
# dev (default) | staging | production. The report names every stub / fallback
# the pipeline runs on (stub escrow, unsigned money webhooks, log-only e-mail,
# missing Apify token, placeholder exporter identity …). In `production` the
# monolith REFUSES TO BOOT while a check fails (READINESS_ENFORCE defaults to
# true there; set false to boot anyway — never with real money).
# ENV_PROFILE=dev
# READINESS_ENFORCE=
# Stripe signed-payload replay window (seconds); 0 disables the check.
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Event bus — NATS JetStream (Synadia Cloud) or in-process
# ---------------------------------------------------------------------------
# Backend selection (default: auto):
#   auto       NATS when a credentials file is found, else in-process bus
#   nats       require NATS (falls back loudly to in-process if unreachable)
#   inprocess  async pub/sub inside one process only (no durability)
#   noop       events vanish (unit tests / bare mode)
# EVENT_BUS_BACKEND=auto
#
# Credentials: download a user .creds file from cloud.synadia.com and either
# drop it anywhere in backend/ (auto-discovered, gitignored via *.creds) or
# point at it explicitly. NEVER commit a .creds file.
# NATS_CREDS_FILE=NGS-Default-CLI.creds
# NATS_URL=tls://connect.ngs.global:4222
#
# Stream/consumer tuning (defaults shown). Durable consumers replay events
# published while the monolith was down; handlers must stay idempotent.
# NATS_STREAM_NAME=PORTLESS_EVENTS
# NATS_SUBJECT_PREFIX=portless
# NATS_ACK_WAIT_SECONDS=120     # must exceed the slowest handler (LLM agent)
# NATS_MAX_DELIVER=5            # redeliveries before dead-letter deal.exception
# NATS_STREAM_MAX_BYTES=134217728  # Synadia requires a bounded stream (128 MiB)

# QC booking fallback when neither the request nor the buyer opted a provider:
# "cheapest" (lowest catalog fee — currently QIMA) or "default" (SGS).
# SHIELD_LINK_QC_FALLBACK_STRATEGY=cheapest

# ---------------------------------------------------------------------------
# Negotiation Agent — LLM (via shared LLM Gateway)
# ---------------------------------------------------------------------------
# Every LLM call in the app goes through shared.llm_gateway.LLMClient to the
# shared LLM Gateway (see "Shared LLM Gateway" above).
# There are no model / provider-key settings in PortLess.

# Per-call generation overrides used by the Negotiation Agent (kept low for
# deterministic routing decisions and predictable price counters).
NEGOTIATION_LLM_TEMPERATURE=0.3
NEGOTIATION_LLM_MAX_TOKENS=2048

# LLM response cache (shared MongoDB TTL cache). Off by default. When enabled,
# identical (messages, model, temperature) requests are served from cache to cut
# token spend. Keep the TTL short so live prices never go stale mid-negotiation.
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Negotiation Agent — MongoDB persistence
# ---------------------------------------------------------------------------
# NEGOTIATION_MONGO_URI=    # optional override of MONGO_URI
# NEGOTIATION_MONGO_DB_NAME= # optional override of MONGO_DB_NAME
NEGOTIATION_SESSIONS_COLLECTION=sessions
NEGOTIATION_ROUNDS_COLLECTION=rounds

# ---------------------------------------------------------------------------
# Email Gateway — email transport: single IMAP + single SMTP config (port 8012)
# ---------------------------------------------------------------------------
# One service owns all credentialed email I/O. It monitors/fetches inbound mail
# over IMAP (automatic, every 15 min) and forwards it to the Email Processor;
# it sends outbound mail over SMTP via POST /email-gateway/send (called by the
# negotiation flow after HITL approval).
#
# Gmail setup (one account serves both IMAP and SMTP):
#   1. Enable IMAP: Settings → Forwarding and POP/IMAP → Enable IMAP
#   2. Enable 2-Step Verification: https://myaccount.google.com/security
#   3. Create an App Password: https://myaccount.google.com/apppasswords
#      Use it for BOTH IMAP_PASSWORD and GMAIL_APP_PASSWORD.
#
# --- Inbound (IMAP) --- leave IMAP_USER empty to disable polling.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-portless-gmail@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=900   # 15 minutes
# Optional dedicated Gmail labels to segregate buyer vs supplier replies.
IMAP_BUYER_FOLDER=INBOX
IMAP_SUPPLIER_FOLDER=INBOX

# --- Outbound (SMTP) --- same Gmail account; leave GMAIL_SENDER_ADDRESS empty
# → outbound messages are logged only (dev/CI mode).
GMAIL_SENDER_ADDRESS=your-portless-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=PortLess Trade Agent
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Forward mode. false (default) = the gateway forwards fetched emails in-process
# to the Email Processor. true = the gateway POSTs each email to the Processor's
# receiving API (POST /email-processor/inbound) — use to run the two apart.
FORWARD_VIA_HTTP=false
EMAIL_GATEWAY_URL=http://localhost:8012

# ---------------------------------------------------------------------------
# Email Processor — inbound processing + persistence (services, port 8013)
# ---------------------------------------------------------------------------
# Receives fetched/pushed emails (from the Gateway's IMAP forward, provider
# webhooks, or manual submission), matches each to a LIVE negotiation, extracts
# the counter-price, persists an audit record, and triggers the orchestration.
#
# MongoDB (falls back to MONGO_URI, then to in-memory when unset).
# EMAIL_PROCESSOR_MONGO_URI=     # optional override of MONGO_URI
# EMAIL_PROCESSOR_MONGO_DB_NAME= # optional override of MONGO_DB_NAME
EMAIL_PROCESSOR_INBOUND_COLLECTION=inbound_emails
EMAIL_PROCESSOR_URL=http://localhost:8013

# PortLess trade identity + price-extraction bounds.
PORTLESS_EMAIL_DOMAIN=portless.io
PORTLESS_TRADE_ADDRESS=portless-trade@portless.io
PRICE_EXTRACTION_MIN=0.01
PRICE_EXTRACTION_MAX=10000000

# Optional provider webhooks (alternatives to IMAP polling; posted to the Processor).
SENDGRID_WEBHOOK_PUBLIC_KEY=
MAILGUN_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Negotiation Agent — session locks
# ---------------------------------------------------------------------------
# Single-instance dev uses an in-memory dict. For multi-replica deployments the
# shared MongoDB cache (see CACHE_* above) is the lock store — no Redis needed.

# ---------------------------------------------------------------------------
# DealMaker / DocuGen — generated document storage (PI/PO, CI/PL/CoO/SDF/Shipping Bill)
# ---------------------------------------------------------------------------
# Google Drive is the PRIMARY document store: each rendered document is
# uploaded to "<GOOGLE_DRIVE_ROOT_FOLDER>/<deal_id>/<filename>" in your own
# Google Drive (shared/connectors/google_drive.py). Local disk
# (DEALMAKER_STORAGE_DIR / DOCUGEN_STORAGE_DIR, default
# <OS temp dir>/portless-docs/<service> — works on both Unix and Windows
# without admin rights) is an emergency fallback only, used when the Drive
# vars are unset or an upload fails — every local write logs a loud warning.
# DEALMAKER_STORAGE_DIR=C:/path/to/.data/dealmaker
# DOCUGEN_STORAGE_DIR=C:/path/to/.data/docugen
#
# Drive's API has no username/password auth, so this uses an OAuth2 refresh
# token instead of a login:
#   1. https://console.cloud.google.com/apis/credentials → enable "Google
#      Drive API" → Create Credentials → OAuth client ID → "Desktop app".
#   2. Copy the Client ID / Client Secret below.
#   3. Run: cd backend && python scripts/google_drive_authorize.py
#      (opens a browser for one-time consent; scope is drive.file — it can
#      only see/edit files this app creates, not your whole Drive) and paste
#      the printed GOOGLE_DRIVE_REFRESH_TOKEN back here.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER=Portless

# ---------------------------------------------------------------------------
# Trade documents — PortLess as exporter of record (shared/documents/issuer.py)
# ---------------------------------------------------------------------------
# Printed on every document. A document that needs one of these and finds it
# empty is issued with a DRAFT banner (never a made-up value); readiness fails
# in production while address / IEC / GSTIN / LUT / AD code are missing.
# PORTLESS_LEGAL_NAME=PortLess Trade Solutions Pvt Ltd
PORTLESS_ADDRESS=
PORTLESS_IEC=
PORTLESS_GSTIN=
PORTLESS_PAN=
PORTLESS_LUT_ARN=            # GST Letter of Undertaking ARN (export without payment of IGST)
PORTLESS_AD_CODE=            # Authorised Dealer bank code registered on ICEGATE
PORTLESS_SIGNATORY_NAME=     # who signs documents (else PORTLESS_SENDER_NAME)
PORTLESS_SIGNATORY_TITLE=
PORTLESS_CONTRACT_LAW=       # sales contract: governing law + dispute forum, e.g. "Laws of India; arbitration in Chennai under the Arbitration and Conciliation Act, 1996"
PORTLESS_MARINE_POLICY=      # marine open policy number (insurance declaration, CIF / CIP)
# PORTLESS_MARINE_CLAUSES=(A)  # Institute Cargo Clauses on the declaration
# CONTRACT_SHIPMENT_DAYS=45    # sales contract: shipment within N days of the escrow being funded

# Prospect matching (shared/orchestration/matchmaking.py) — buyer x supplier match board
MATCHMAKING_ENABLED=true
MATCH_MIN_PROBABILITY=0.45
MATCH_OFFER_VALIDITY_DAYS=30
RFQ_MAX_SUPPLIERS=5
# Landed-cost assumptions (freight per MT by region unless overridden)
# LANDED_FREIGHT_USD_PER_MT=
# LANDED_FREIGHT_USD_PER_MT_ES=
LANDED_INSURANCE_PCT=0.5
LANDED_INSPECTION_USD_PER_SHIPMENT=600
LANDED_ESCROW_FEE_PCT=1.0

# Memory in knowledge-service (RouteToRich RAG) via the API gateway — uses LLM_GATEWAY_URL + the service account
KNOWLEDGE_ENABLED=true
KNOWLEDGE_COLLECTION=portless-trade
# KNOWLEDGE_GATEWAY_PATH=/api/knowledge/api/v1
# KNOWLEDGE_ACL=            # comma list; default = the service account's user id
# Outcome feedback loop
MATCH_CALIBRATION_MIN=20

# ── Automation mode (console toggle; services/automation) ───────────────────
# The backend runs a second copy of the app on 127.0.0.1 (the view server) for
# Automation-mode pages, connected only to portless_automation, plus one worker
# process per run. On a deployed backend: ENV_PROFILE must not be production,
# the host must allow child processes (about twice the app's memory while a run
# or the view server is up), and AUTH_PORTLESS_EMAILS must list the operators.
# GET /automation/diagnostics (staff) shows the state and the last log lines.
AUTOMATION_VIEW_PORT=8082          # local port of the view server
AUTOMATION_VIEW_AUTOSTART=true     # start it with the backend (not on production)
AUTOMATION_VIEW_WAIT_SECONDS=8     # per request, then 503 "starting" (the console retries)

