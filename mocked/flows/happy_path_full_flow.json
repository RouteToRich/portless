{
  "_description": "Complete happy-path deal flow from opportunity detection to PAID status",
  "_deal_id": "DEAL-HAPPY-PATH-001",
  "steps": [
    {
      "step": 1,
      "name": "Opportunity Detected",
      "api": "GET /trade-min/opportunities",
      "response_file": "trade_min/scan_result.json",
      "deal_status": null
    },
    {
      "step": 2,
      "name": "Deal Created",
      "api": "POST /deals",
      "request": {
        "opportunity_id": "OPP-2024-101",
        "buyer_id": "BUYER-RATAN-EXPORTS",
        "commodity": "Cumin Seeds",
        "quantity_mt": 25,
        "buyer_price_usd": 1800
      },
      "response_file": "deals/deal_detail_negotiating.json",
      "deal_status": "MATCHING"
    },
    {
      "step": 3,
      "name": "Quote Submitted by Supplier",
      "api": "POST /sourcing/quotes",
      "response_file": "sourcing/quote_submit_response.json",
      "deal_status": "NEGOTIATING"
    },
    {
      "step": 4,
      "name": "Negotiation Rounds → Agreed",
      "api": "POST /negotiation-agent/negotiations/{id}/round (×2)",
      "response_file": "negotiation_agent/negotiation_agreed.json",
      "deal_status": "NEGOTIATION_AGREED"
    },
    {
      "step": 5,
      "name": "Proforma Invoice Issued",
      "api": "POST /dealmaker/pi",
      "response_file": "dealmaker/pi_issued.json",
      "deal_status": "PI_SENT"
    },
    {
      "step": 6,
      "name": "PI Accepted by Buyer",
      "api": "POST /dealmaker/pi/{id}/accept",
      "request": {"accepted_by": "procurement@buyer.ae"},
      "response": {"pi_id": "PI-20240118-001", "status": "ACCEPTED"},
      "deal_status": "PI_ACCEPTED"
    },
    {
      "step": 7,
      "name": "Escrow Hold Created",
      "api": "POST /escrow-guard/holds",
      "response_file": "escrow_guard/hold_created.json",
      "deal_status": "ESCROW_PENDING"
    },
    {
      "step": 8,
      "name": "Buyer Pays → Escrow Funded Webhook",
      "api": "POST /escrow-guard/webhooks/escrow-funded",
      "response_file": "escrow_guard/hold_funded_webhook.json",
      "deal_status": "ESCROW_FUNDED"
    },
    {
      "step": 9,
      "name": "HITL Approval for PO",
      "api": "POST /hitl-approval/approvals + GET /hitl-approval/stream",
      "response_file": "hitl_approval/approval_pending_l0.json",
      "deal_status": "ESCROW_FUNDED",
      "note": "Operator approves via UI deep link"
    },
    {
      "step": 10,
      "name": "Purchase Order Issued",
      "api": "POST /dealmaker/po (callback from HITL)",
      "response_file": "dealmaker/po_issued.json",
      "deal_status": "PO_ISSUED"
    },
    {
      "step": 11,
      "name": "QC Inspection Booked",
      "api": "POST /shield-link/qc",
      "response_file": "shield_link/qc_booking.json",
      "deal_status": "SUPPLIER_DISPATCH_READY"
    },
    {
      "step": 12,
      "name": "SGS QC Webhook → Passed",
      "api": "POST /shield-link/webhooks/qc",
      "response_file": "shield_link/qc_webhook_passed.json",
      "deal_status": "QC_PASSED"
    },
    {
      "step": 13,
      "name": "Documents Generated",
      "api": "POST /docugen/documents (×5: CI, PL, CoO, SDF, SB)",
      "response_file": "docugen/documents_list.json",
      "deal_status": "QC_PASSED",
      "note": "Parallel to freight booking"
    },
    {
      "step": 14,
      "name": "Freight Booked",
      "api": "POST /shield-link/freight",
      "response_file": "shield_link/freight_booking.json",
      "deal_status": "IN_TRANSIT"
    },
    {
      "step": 15,
      "name": "Customs Filed",
      "api": "POST /docugen/customs/file",
      "response_file": "docugen/customs_filed.json",
      "deal_status": "IN_TRANSIT"
    },
    {
      "step": 16,
      "name": "Freight Milestone — Arrived & Cleared",
      "api": "POST /shield-link/webhooks/freight",
      "response_file": "shield_link/freight_milestone_cleared.json",
      "deal_status": "CLEARED"
    },
    {
      "step": 17,
      "name": "Supplier Payout",
      "api": "POST /escrow-guard/payouts",
      "response_file": "escrow_guard/payout_completed.json",
      "deal_status": "PAID"
    }
  ]
}
