# =============================================================================
# LLM access — Configuration Template (optional module-local overrides)
# Env-var prefix: LLM_
#
# PortLess holds NO model provider key (no Groq / OpenAI / Anthropic / Gemini).
# Every chat call goes to the shared RouteToRich LLM Gateway — set
# LLM_GATEWAY_URL and the service-account credential in the repository-root
# .env next to MONGO_URI (see .env.example, "Shared LLM Gateway"). This file only
# holds tuning knobs; copy to .env here if you need to change any of them.
# =============================================================================


# ── Inbound JWT auth for gateway-facing routes (auth.py) ─────────────────────
LLM_AUTH_ENABLED=false
LLM_JWT_SECRET=CHANGE_ME_IN_PRODUCTION
LLM_JWT_ALGORITHM=HS256
LLM_JWT_ISSUER=portless
LLM_JWT_AUDIENCE=portless-llm-gateway


# ── Shared LLM Gateway transport (URL + credential live in root .env) ────────
LLM_GATEWAY_LLM_PATH=/api/llm
LLM_GATEWAY_AUTH_PATH=/auth/login
LLM_GATEWAY_TOKEN_TTL_SECONDS=3000
LLM_GATEWAY_TIMEOUT_SECONDS=120
LLM_GATEWAY_CALLER_PREFIX=portless


# ── Generation defaults ───────────────────────────────────────────────────────
LLM_LLM_TEMPERATURE=0.7
LLM_LLM_MAX_TOKENS=2048


# ── Request tracking (local record next to the gateway's metering) ────────────
LLM_TRACKING_ENABLED=true
LLM_TRACKING_FILE_PATH=data/llm_gateway_tracking.txt


# ── MongoDB tracker (defaults to MONGO_URI / MONGO_DB_NAME) ───────────────────
LLM_MONGO_TRACKER_ENABLED=true
LLM_MONGO_COLLECTION=llm_requests
LLM_MONGO_MAX_POOL_SIZE=50
LLM_MONGO_CONNECT_TIMEOUT_MS=5000
LLM_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
LLM_MONGO_SOCKET_TIMEOUT_MS=30000


# ── Response cache (shared MongoDB TTL cache) ─────────────────────────────────
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=120
