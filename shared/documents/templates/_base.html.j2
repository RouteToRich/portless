<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block kind %}{% endblock %} {% block number %}{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #0f172a; --ink-2: #334155; --muted: #64748b; --faint: #94a3b8;
    --line: #e2e8f0; --line-2: #cbd5e1; --surface: #f8fafc; --paper: #ffffff;
    --accent: #0f766e; --accent-soft: #ccfbf1; --accent-ink: #134e4a;
    --warn: #b45309; --warn-soft: #fef3c7; --bad: #b91c1c; --bad-soft: #fee2e2; --ok: #15803d; --ok-soft: #dcfce7;
    --radius: 10px;
  }
  @page { size: A4; margin: 14mm 14mm 16mm; }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; background: #eef2f6; color: var(--ink); font: 400 10.5pt/1.5 "Inter", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-variant-numeric: tabular-nums; }
  .sheet { position: relative; max-width: 210mm; margin: 24px auto; background: var(--paper); padding: 16mm 15mm 14mm; border-radius: 4px; box-shadow: 0 1px 3px rgba(15,23,42,.08), 0 12px 32px rgba(15,23,42,.08); overflow: hidden; }
  @media print { body { background: none; } .sheet { margin: 0; padding: 0; box-shadow: none; max-width: none; } }
  @media (max-width: 640px) { .sheet { margin: 0; padding: 20px 16px; border-radius: 0; } .grid-2, .grid-3, .facts { grid-template-columns: 1fr !important; } }

  .mono { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .92em; }
  .muted { color: var(--muted); } .small { font-size: 8.5pt; } .right { text-align: right; } .nowrap { white-space: nowrap; }
  h2 { font-size: 9pt; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin: 22px 0 8px; display: flex; align-items: center; gap: 8px; }
  h2::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  p { margin: 0 0 6px; }

  /* Header */
  .doc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; padding-bottom: 14px; border-bottom: 2px solid var(--ink); }
  .brand { display: flex; gap: 12px; align-items: center; }
  .mark { width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, var(--accent), #0e7490); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 18px; letter-spacing: -.02em; }
  .brand-name { font-weight: 700; font-size: 13pt; letter-spacing: -.01em; }
  .brand-legal { color: var(--muted); font-size: 8.5pt; }
  .doc-id { text-align: right; }
  .kind { font-size: 19pt; font-weight: 700; letter-spacing: -.02em; line-height: 1.1; }
  .kind-sub { color: var(--muted); font-size: 8.5pt; margin-top: 2px; }
  .no { margin-top: 4px; color: var(--ink-2); } .no .mono { font-weight: 500; }
  .chip { display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 999px; font-size: 8pt; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; background: var(--accent-soft); color: var(--accent-ink); }
  .chip.warn { background: var(--warn-soft); color: var(--warn); } .chip.bad { background: var(--bad-soft); color: var(--bad); } .chip.ok { background: var(--ok-soft); color: var(--ok); }

  /* Draft */
  .draft { margin: 14px 0 0; padding: 10px 14px; border-radius: var(--radius); background: var(--warn-soft); color: #78350f; border: 1px solid #fcd34d; font-size: 9pt; }
  .draft strong { letter-spacing: .04em; }
  .watermark { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; z-index: 0; }
  .watermark span { transform: rotate(-30deg); font-size: 110px; font-weight: 800; color: rgba(180,83,9,.07); letter-spacing: .1em; }
  .content { position: relative; z-index: 1; }

  /* Key facts */
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin-top: 16px; }
  .fact { background: var(--surface); padding: 8px 12px; }
  .fact .l { font-size: 7.5pt; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 600; }
  .fact .v { font-weight: 600; margin-top: 1px; word-break: break-word; }

  /* Parties */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; } .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .card { border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; break-inside: avoid; }
  .card .role { font-size: 7.5pt; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); font-weight: 700; margin-bottom: 4px; }
  .card .name { font-weight: 600; font-size: 11pt; margin-bottom: 2px; }
  .card .line { color: var(--ink-2); font-size: 9.5pt; }
  .card .ids { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 8.5pt; color: var(--muted); }

  /* Tables */
  table { width: 100%; border-collapse: collapse; break-inside: auto; }
  thead th { font-size: 7.5pt; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 600; text-align: left; padding: 8px 10px; border-bottom: 1.5px solid var(--ink); }
  tbody td { padding: 9px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  tbody tr:nth-child(even) td { background: #fbfdfe; }
  th.num, td.num { text-align: right; white-space: nowrap; }
  .kv { width: 100%; } .kv td { padding: 6px 0; border-bottom: 1px dashed var(--line); background: none !important; }
  .kv td:first-child { color: var(--muted); width: 38%; padding-right: 12px; }

  /* Totals */
  .totals { margin-left: auto; width: 46%; margin-top: 10px; }
  .totals .row { display: flex; justify-content: space-between; padding: 5px 0; color: var(--ink-2); }
  .totals .grand { margin-top: 4px; padding: 10px 12px; border-radius: var(--radius); background: var(--ink); color: #fff; font-weight: 700; font-size: 12pt; }
  .words { margin-top: 8px; font-size: 9pt; color: var(--ink-2); } .words strong { color: var(--ink); }

  /* Notices */
  .notice { border-radius: var(--radius); padding: 10px 14px; font-size: 9pt; margin-top: 12px; border: 1px solid var(--line); background: var(--surface); break-inside: avoid; }
  .notice.accent { background: #f0fdfa; border-color: #99f6e4; color: var(--accent-ink); }
  .notice.warn { background: var(--warn-soft); border-color: #fcd34d; color: #78350f; }
  .notice.bad { background: var(--bad-soft); border-color: #fca5a5; color: #7f1d1d; }
  .clauses { counter-reset: c; padding: 0; margin: 0; list-style: none; }
  .clauses > li { counter-increment: c; position: relative; padding: 0 0 8px 30px; break-inside: avoid; }
  .clauses > li::before { content: counter(c) "."; position: absolute; left: 0; top: 0; font-weight: 700; color: var(--accent); }
  .clauses > li strong:first-child { color: var(--ink); }
  .checks { list-style: none; padding: 0; margin: 0; } .checks li { padding: 3px 0 3px 22px; position: relative; }
  .checks li::before { content: ""; position: absolute; left: 2px; top: 7px; width: 10px; height: 10px; border: 1.5px solid var(--accent); border-radius: 3px; }

  /* Escrow timeline */
  .timeline { display: flex; gap: 3px; margin: 6px 0 4px; }
  .seg { padding: 8px 10px; border-radius: 8px; background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .seg.done { background: #f0fdfa; border-color: #99f6e4; }
  .seg .p { font-weight: 700; font-size: 12pt; color: var(--accent); } .seg .t { font-size: 8pt; color: var(--ink-2); line-height: 1.3; } .seg .a { font-size: 8.5pt; font-weight: 600; margin-top: 2px; }

  /* Signatures + footer */
  .signs { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 30px; break-inside: avoid; }
  .sign .space { height: 46px; border-bottom: 1px solid var(--ink); }
  .sign .who { margin-top: 6px; font-weight: 600; } .sign .what { color: var(--muted); font-size: 8.5pt; }
  .foot { margin-top: 28px; padding-top: 10px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; font-size: 7.5pt; color: var(--faint); }
</style>
</head>
<body>
<div class="sheet">
  {% if draft_reasons %}<div class="watermark"><span>DRAFT</span></div>{% endif %}
  <div class="content">
  <header class="doc-head">
    <div class="brand">
      <div class="mark">{{ (exporter.brand or "P")[:1] }}</div>
      <div>
        <div class="brand-name">{{ exporter.brand }}</div>
        <div class="brand-legal">{{ exporter.name }}</div>
      </div>
    </div>
    <div class="doc-id">
      <div class="kind">{{ self.kind() }}</div>
      {% block kind_sub %}{% endblock %}
      <div class="no">No. <span class="mono">{{ self.number() }}</span></div>
      {% block chip %}{% endblock %}
    </div>
  </header>

  {% if draft_reasons %}
  <div class="draft"><strong>DRAFT — NOT VALID FOR USE.</strong> Complete before issuing: {{ draft_reasons | join("; ") }}.</div>
  {% endif %}

  {% block facts_wrap %}<section class="facts">{% block facts %}{% endblock %}</section>{% endblock %}

  {% block content %}{% endblock %}

  <footer class="foot">
    <div>
      {{ exporter.name }}{% if exporter.address %} · {{ exporter.address }}{% endif %}
      {% if exporter.iec %} · IEC {{ exporter.iec }}{% endif %}{% if exporter.gstin %} · GSTIN {{ exporter.gstin }}{% endif %}
    </div>
    <div class="right nowrap">
      {{ self.number() }}{% if deal_id %} · Deal {{ deal_id }}{% endif %} · Generated {{ generated_at | date }}<br>
      SHA-256 of this file is recorded in the deal's audit trail
    </div>
  </footer>
  </div>
</div>
</body>
</html>
